[
 {quod,
  [{listen_port, 14567},
   {alpn, "quod"},
   {certfile, "priv/certs/cert.pem"},
   {keyfile, "priv/certs/key.pem"},
   %% bootstrap peers to dial on join, e.g. [{"127.0.0.1", 14568}]
   {seed_peers, []}
  ]},

 {kernel,
  [{logger_level, info},
   %% JSON logs to stdout: the qengho promtail `{job="docker"}` scrape ships these
   %% and Loki's `| json` parser exposes `level`/`msg`/`node_id`/`mfa` as queryable
   %% fields in Grafana. `node_id` is stamped into the primary metadata at boot by
   %% quod_app, so a 30-node fleet's warnings are attributable per instance.
   {logger,
    [{handler, default, logger_std_h,
      #{level     => info,
        config    => #{type => standard_io},
        formatter => {quod_log_formatter, #{}}}}]}
  ]}
].
