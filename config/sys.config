[
 {quod,
  [{listen_port, 14567},
   {alpn, "quod"},
   {certfile, "priv/certs/cert.pem"},
   {keyfile, "priv/certs/key.pem"},
   %% bootstrap peers to dial on join, e.g. [{"127.0.0.1", 14568}]
   {seed_peers, []}
  ]},

 %% Tracing is explicitly opt-in. Production enables these with standard
 %% OTEL_* environment variables; the batch processor keeps exporter I/O off
 %% proof and consensus processes.
 {opentelemetry,
  [{traces_exporter, none},
   {sampler, always_off},
   {span_processor, batch},
   {bsp_max_queue_size, 2048},
   {bsp_scheduled_delay_ms, 1000},
   {bsp_exporting_timeout_ms, 5000},
   {attribute_count_limit, 32},
   {event_count_limit, 32},
   {attribute_value_length_limit, 512}]},

 {opentelemetry_exporter,
  [{otlp_protocol, http_protobuf},
   {otlp_endpoint, "http://127.0.0.1:4318"}]},

 {kernel,
  [{logger_level, info},
   %% JSON logs to stdout: the qengho promtail `{job="docker"}` scrape ships these
   %% and Loki's `| json` parser exposes `level`/`msg`/`node_id`/`mfa` as queryable
   %% fields in Grafana. `node_id` is stamped into the primary metadata at boot by
   %% quod_app, so a 30-node fleet's warnings are attributable per instance.
   {logger,
    [{handler, default, logger_std_h,
      #{level     => info,
        config    => #{type => standard_io},
        formatter => {quod_log_formatter, #{}}}}]}
  ]}
].
