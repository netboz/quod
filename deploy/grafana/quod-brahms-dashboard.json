          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "{job=\"docker\"} |~ \"node_id\" | json | node_id=~\"kp_.+\" | level=~\"warning|error|notice\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
