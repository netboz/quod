{
  "__inputs": [],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["quod"],
  "title": "quod — consensus & content layer",
  "uid": "quod-content",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(quod_up, node_id)",
        "query": { "query": "label_values(quod_up, node_id)", "refId": "n" },
        "label": "Node",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(quod_consensus_slot, namespace)",
        "query": { "query": "label_values(quod_consensus_slot, namespace)", "refId": "ns" },
        "label": "Namespace",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1 },
    {
      "type": "stat", "id": 2, "title": "Nodes up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value_and_name" },
      "targets": [ { "refId": "A", "expr": "count(quod_up{node_id=~\"$node\"} == 1)", "legendFormat": "up" } ]
    },
    {
      "type": "timeseries", "id": 3, "title": "Consensus height (slot / committed / applied)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 1 },
      "description": "A growing gap between slot and last_applied means blocks are committing faster than the fact engine applies them.",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [
        { "refId": "A", "expr": "quod_consensus_slot{node_id=~\"$node\", namespace=~\"$namespace\"}", "legendFormat": "slot · {{node_id}}/{{namespace}}" },
        { "refId": "B", "expr": "quod_consensus_committed{node_id=~\"$node\", namespace=~\"$namespace\"}", "legendFormat": "committed · {{node_id}}/{{namespace}}" },
        { "refId": "C", "expr": "quod_consensus_last_applied{node_id=~\"$node\", namespace=~\"$namespace\"}", "legendFormat": "applied · {{node_id}}/{{namespace}}" }
      ]
    },

    { "type": "row", "title": "Transactions", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "id": 10 },
    {
      "type": "timeseries", "id": 11, "title": "Incoming transaction rate (submitted)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "description": "Append attempts per second on each node (the submit rate). Reuses the cumulative quod_consensus_submitted counter.",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [ { "refId": "A", "expr": "rate(quod_consensus_submitted{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "{{node_id}}/{{namespace}}" } ]
    },
    {
      "type": "timeseries", "id": 12, "title": "Commit & apply rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "description": "Blocks committed vs facts applied per second. commits is per committing node; applies is universal (member + follower via the feed).",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [
        { "refId": "A", "expr": "rate(quod_consensus_commits{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "commit · {{node_id}}/{{namespace}}" },
        { "refId": "B", "expr": "rate(quod_prolog_applies{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "apply · {{node_id}}/{{namespace}}" }
      ]
    },
    {
      "type": "timeseries", "id": 13, "title": "Transaction processing time (submit → commit)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "description": "Percentiles of block.timestamp − tx.submitted_at, from the quod_tx_commit_latency_ms histogram. Observed on the committing node (accurate at N=1 where submitter == committer).",
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, node_id, namespace) (rate(quod_tx_commit_latency_ms_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p50 · {{node_id}}/{{namespace}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, node_id, namespace) (rate(quod_tx_commit_latency_ms_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p95 · {{node_id}}/{{namespace}}" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le, node_id, namespace) (rate(quod_tx_commit_latency_ms_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p99 · {{node_id}}/{{namespace}}" }
      ]
    },
    {
      "type": "timeseries", "id": 14, "title": "Committed transactions by author",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "description": "Per-submitting-node committed-tx rate (author = the node that originated the write). Driven by the live {committed,Ns} event.",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "showPoints": "never", "stacking": { "mode": "normal" } } } },
      "targets": [ { "refId": "A", "expr": "sum by (author, namespace) (rate(quod_tx_committed_total{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "{{author}} · {{namespace}}" } ]
    },
    {
      "type": "timeseries", "id": 15, "title": "Write size (asserts + retracts per tx)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "description": "Percentiles of the diff size per committed transaction (quod_tx_diff_ops histogram).",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, namespace) (rate(quod_tx_diff_ops_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p50 · {{namespace}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(quod_tx_diff_ops_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p95 · {{namespace}}" }
      ]
    },
    {
      "type": "timeseries", "id": 16, "title": "In-flight writes (pending appends / parked)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "description": "Liveness: consensus appends awaiting commit, and quod_prolog writes parked awaiting their verdict. Sustained non-zero = writes not committing.",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [
        { "refId": "A", "expr": "quod_consensus_pending{node_id=~\"$node\", namespace=~\"$namespace\"}", "legendFormat": "pending · {{node_id}}/{{namespace}}" },
        { "refId": "B", "expr": "quod_prolog_parked{node_id=~\"$node\", namespace=~\"$namespace\"}", "legendFormat": "parked · {{node_id}}/{{namespace}}" }
      ]
    },

    { "type": "row", "title": "Rejections & failures", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "id": 20 },
    {
      "type": "timeseries", "id": 21, "title": "Append rejections by reason",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "description": "Routing/flow-control outcomes, NOT hard failures: busy = backpressure, redirect = not this slot's leader, bad = unacceptable change, skipped = slot complaint-skipped.",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "showPoints": "never", "stacking": { "mode": "normal" } } } },
      "targets": [
        { "refId": "A", "expr": "rate(quod_consensus_append_busy{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "busy · {{node_id}}" },
        { "refId": "B", "expr": "rate(quod_consensus_append_redirect{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "redirect · {{node_id}}" },
        { "refId": "C", "expr": "rate(quod_consensus_append_bad{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "bad_change · {{node_id}}" },
        { "refId": "D", "expr": "rate(quod_consensus_skips{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "skipped · {{node_id}}" }
      ]
    },
    {
      "type": "timeseries", "id": 22, "title": "Failed writes (OCC conflict / rejects / park timeouts)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "description": "Real write failures: OCC conflicts + apply-time rejects (read-set changed under the write), and parked writes reaped by TTL (verdict never arrived).",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [
        { "refId": "A", "expr": "rate(quod_prolog_conflicts{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "occ_conflict · {{node_id}}" },
        { "refId": "B", "expr": "rate(quod_prolog_rejects{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "reject · {{node_id}}" },
        { "refId": "C", "expr": "rate(quod_prolog_park_timeouts{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "park_timeout · {{node_id}}" }
      ]
    },

    { "type": "row", "title": "Dissemination feed", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 }, "id": 30 },
    {
      "type": "timeseries", "id": 31, "title": "Feed activity (pushed / ingested / pulled)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "description": "Dissemination health: locally-originated pushes, gossiped blocks verified+applied+relayed, and anti-entropy pull ROUNDS (not blocks).",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [
        { "refId": "A", "expr": "rate(quod_feed_pushed{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "pushed · {{node_id}}" },
        { "refId": "B", "expr": "rate(quod_feed_ingested{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "ingested · {{node_id}}" },
        { "refId": "C", "expr": "rate(quod_feed_pulled{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "pull_rounds · {{node_id}}" }
      ]
    },
    {
      "type": "timeseries", "id": 32, "title": "Feed dropped blocks",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "description": "Duplicate / gap / unverified / non-following drops. A burst of gap-drops precedes an anti-entropy pull (see deferred: reorder buffer).",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [ { "refId": "A", "expr": "rate(quod_feed_dropped{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "dropped · {{node_id}}" } ]
    },

    { "type": "row", "title": "Brahms overlay", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 }, "id": 40 },
    {
      "type": "timeseries", "id": 41, "title": "Overlay (view / sample / links)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 51 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [
        { "refId": "A", "expr": "quod_brahms_view_size{node_id=~\"$node\", namespace=~\"$namespace\"}", "legendFormat": "view · {{node_id}}" },
        { "refId": "B", "expr": "quod_brahms_sample_size{node_id=~\"$node\", namespace=~\"$namespace\"}", "legendFormat": "sample · {{node_id}}" },
        { "refId": "C", "expr": "quod_brahms_links{node_id=~\"$node\", namespace=~\"$namespace\"}", "legendFormat": "links · {{node_id}}" }
      ]
    },
    {
      "type": "timeseries", "id": 42, "title": "Estimated network size (n̂)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 51 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "showPoints": "never" } } },
      "targets": [ { "refId": "A", "expr": "quod_brahms_estimated_n{node_id=~\"$node\", namespace=~\"$namespace\"}", "legendFormat": "n̂ · {{node_id}}/{{namespace}}" } ]
    }
  ]
}
