{
  "__inputs": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "quod"
  ],
  "title": "quod — consensus & content layer",
  "uid": "quod-content",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(quod_up, node_id)",
        "query": {
          "query": "label_values(quod_up, node_id)",
          "refId": "n"
        },
        "label": "Node",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(quod_consensus_slot, namespace)",
        "query": {
          "query": "label_values(quod_consensus_slot, namespace)",
          "refId": "ns"
        },
        "label": "Namespace",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Nodes up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(quod_up{node_id=~\"$node\"} == 1)",
          "legendFormat": "up"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Consensus height (slot / committed / applied)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "description": "A growing gap between slot and last_applied means blocks are committing faster than the fact engine applies them.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_consensus_slot{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "slot · {{node_id}}/{{namespace}}"
        },
        {
          "refId": "B",
          "expr": "quod_consensus_committed{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "committed · {{node_id}}/{{namespace}}"
        },
        {
          "refId": "C",
          "expr": "quod_consensus_last_applied{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "applied · {{node_id}}/{{namespace}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Transactions",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Incoming transaction rate (submitted)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "Append attempts per second on each node (the submit rate). Reuses the cumulative quod_consensus_submitted counter.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(quod_consensus_submitted{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "{{node_id}}/{{namespace}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Commit & apply rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "description": "Blocks committed vs facts applied per second. commits is per committing node; applies is universal (member + follower via the feed).",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(quod_consensus_commits{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "commit · {{node_id}}/{{namespace}}"
        },
        {
          "refId": "B",
          "expr": "rate(quod_prolog_applies{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "apply · {{node_id}}/{{namespace}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Transaction processing time (submit → commit)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "description": "Percentiles of block.timestamp − tx.submitted_at, from the quod_tx_commit_latency_ms histogram. Observed on the committing node (accurate at N=1 where submitter == committer).",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, node_id, namespace) (rate(quod_tx_commit_latency_ms_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50 · {{node_id}}/{{namespace}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, node_id, namespace) (rate(quod_tx_commit_latency_ms_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 · {{node_id}}/{{namespace}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, node_id, namespace) (rate(quod_tx_commit_latency_ms_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p99 · {{node_id}}/{{namespace}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Committed transactions by author",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "description": "Per-submitting-node committed-tx rate (author = the node that originated the write). Driven by the live {committed,Ns} event.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (author, namespace) (rate(quod_tx_committed_total{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{author}} · {{namespace}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Write size (asserts + retracts per tx)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "description": "Percentiles of the diff size per committed transaction (quod_tx_diff_ops histogram).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, namespace) (rate(quod_tx_diff_ops_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50 · {{namespace}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(quod_tx_diff_ops_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 · {{namespace}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "In-flight writes (pending appends / parked)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "description": "Liveness: consensus appends awaiting commit, and quod_prolog writes parked awaiting their verdict. Sustained non-zero = writes not committing.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_consensus_pending{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "pending · {{node_id}}/{{namespace}}"
        },
        {
          "refId": "B",
          "expr": "quod_prolog_parked{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "parked · {{node_id}}/{{namespace}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 17,
      "title": "Prolog execution & memory",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "timeseries",
      "id": 18,
      "title": "Active queries & cross-ontology answers",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "description": "Queries running on this node, and cross-ontology answer streams it is serving. Each uses a frozen data view. Proof workers reaching the configured limit cause new queries to receive a busy response until one finishes.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_prolog_proof_workers{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "local queries · {{node_id}}"
        },
        {
          "refId": "B",
          "expr": "quod_prolog_ask_workers{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "cross-ontology answers · {{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "Knowledge-base memory & retained history",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "description": "Shared knowledge-base ETS memory (left axis, Erlang VM words) and predicates retaining an older version (right axis). Retained history should fall back to 0 after frozen queries finish; persistent growth points to slow or stuck queries.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_prolog_kb_memory_words{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "KB memory (VM words) · {{node_id}}"
        },
        {
          "refId": "B",
          "expr": "quod_prolog_kb_history_predicates{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "retained history · {{node_id}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Rejections & failures",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "id": 20
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Append rejections by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "description": "Routing/flow-control outcomes, NOT hard failures: busy = backpressure, redirect = not this slot's leader, bad = unacceptable change, skipped = slot complaint-skipped.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(quod_consensus_append_busy{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "busy · {{node_id}}"
        },
        {
          "refId": "B",
          "expr": "rate(quod_consensus_append_redirect{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "redirect · {{node_id}}"
        },
        {
          "refId": "C",
          "expr": "rate(quod_consensus_append_bad{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "bad_change · {{node_id}}"
        },
        {
          "refId": "D",
          "expr": "rate(quod_consensus_skips{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "skipped · {{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Failed writes (OCC conflict / rejects / park timeouts)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "description": "Real write failures: OCC conflicts + apply-time rejects (read-set changed under the write), and parked writes reaped by TTL (verdict never arrived).",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(quod_prolog_conflicts{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "occ_conflict · {{node_id}}"
        },
        {
          "refId": "B",
          "expr": "rate(quod_prolog_rejects{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "reject · {{node_id}}"
        },
        {
          "refId": "C",
          "expr": "rate(quod_prolog_park_timeouts{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "park_timeout · {{node_id}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Dissemination feed",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "id": 30
    },
    {
      "type": "timeseries",
      "id": 101,
      "title": "Feed: blocks sent out (per node)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "description": "How many final blocks each node produced and started sending to the rest of the network, per second.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(quod_feed_pushed{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 102,
      "title": "Feed: blocks received & relayed (per node)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "description": "How many blocks each node received from others, checked, applied and passed along, per second.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(quod_feed_ingested{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 103,
      "title": "Feed: catch-up pulls (per node)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 59
      },
      "description": "How often each node had to ask others for blocks it was missing, per second.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(quod_feed_pulled{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "Feed dropped blocks",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 59
      },
      "description": "Dropped blocks broken down by reason. duplicate = benign gossip redundancy (loop-suppressed); gap = out-of-order, re-pulled by anti-entropy; unverified = bad cert (the one to watch); non_following/oversized/ingest_busy. Only unverified (and sustained gap) indicate a real problem.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(quod_feed_dropped{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Brahms overlay",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 67
      },
      "id": 40
    },
    {
      "type": "timeseries",
      "id": 104,
      "title": "Peers known (per node)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 68
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_brahms_view_size{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "{{node_id}}"
        }
      ],
      "description": "How many other nodes each node currently knows about."
    },
    {
      "type": "timeseries",
      "id": 105,
      "title": "Gossip sample size (per node)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 68
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_brahms_sample_size{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "{{node_id}}"
        }
      ],
      "description": "How many known nodes each node is actively sharing updates with, so gossip stays even."
    },
    {
      "type": "timeseries",
      "id": 106,
      "title": "Open connections (per node)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 76
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_brahms_links{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "{{node_id}}"
        }
      ],
      "description": "How many other nodes each node has an open connection to right now."
    },
    {
      "type": "timeseries",
      "id": 42,
      "title": "Estimated total population N",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 76
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_brahms_estimated_n{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "estimated N · {{node_id}}/{{namespace}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 44,
      "title": "Committee & membership",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 84
      }
    },
    {
      "type": "timeseries",
      "id": 107,
      "title": "Committee size (nodes allowed to vote)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 85
      },
      "description": "How many nodes are currently allowed to vote on changes. Every node should report the same value.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_consensus_committee_size{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 108,
      "title": "Voter or observer, per node (1 = can vote)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 85
      },
      "description": "1 if the node is allowed to vote, 0 if it only reads and follows along.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_consensus_is_validator{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 46,
      "title": "Admission readiness (liveness digests)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 93
      },
      "description": "On a committee member: how many peers it tracks a liveness heartbeat for (digests) and how many are FRESH right now (fresh_digests). A candidate must be fresh here before it can be admitted. Confirm this is non-zero for the candidate before an admit.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_feed_digests{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "tracked · {{node_id}}"
        },
        {
          "refId": "B",
          "expr": "quod_feed_fresh_digests{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "fresh · {{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 48,
      "title": "Finality watchdog state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 101
      },
      "description": "State of the oldest unfinished block on each node. phase: 0 idle, 1 waiting for a proposal, 2 waiting for support, 3 waiting for final commit votes. quorum_ready is 1 when enough linked validators have freshly reported that they are caught up to this node; complaint voting pauses while it is 0.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 3,
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quod_consensus_progress_phase{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "phase · {{node_id}}"
        },
        {
          "refId": "B",
          "expr": "quod_consensus_progress_quorum_ready{node_id=~\"$node\", namespace=~\"$namespace\"}",
          "legendFormat": "quorum ready · {{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 47,
      "title": "Consensus recovery activity",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 101
      },
      "description": "Recovery work per second: proposal/finality redrives, oldest-head watchdog expirations, complaints paused during a known below-quorum outage, weak-certificate waits, and invalid membership proposals. These should stay near zero in steady state; a burst should return to zero after connectivity recovers.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(quod_consensus_redrives{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "redrives · {{node_id}}"
        },
        {
          "refId": "B",
          "expr": "rate(quod_consensus_weak_cert_waits{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "weak_cert_waits · {{node_id}}"
        },
        {
          "refId": "C",
          "expr": "rate(quod_consensus_membership_rejects{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "membership_rejects · {{node_id}}"
        },
        {
          "refId": "D",
          "expr": "rate(quod_consensus_progress_timeouts{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "head timeouts · {{node_id}}"
        },
        {
          "refId": "E",
          "expr": "rate(quod_consensus_quorum_pauses{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "quorum pauses · {{node_id}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 109,
      "title": "Transaction authentication",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 109
      }
    },
    {
      "type": "timeseries",
      "id": 110,
      "title": "Author signature check time",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 110
      },
      "description": "Median and 95th-percentile time each node spends checking one transaction author's Ed25519 signature before voting. A sustained rise means authentication is consuming more of the block-processing budget.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, node_id) (rate(quod_tx_signature_validation_seconds_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50 · {{node_id}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, node_id) (rate(quod_tx_signature_validation_seconds_bucket{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 · {{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 111,
      "title": "Invalid author signatures rejected",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 110
      },
      "description": "Rate of transactions rejected because the author's cryptographic signature did not match the signed content. This should stay at zero; any increase means corrupted, malformed, or dishonest input reached a validator.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_id) (rate(quod_tx_invalid_signatures_total{node_id=~\"$node\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "type": "logs",
      "id": 43,
      "title": "Node logs — warnings & errors (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 118
      },
      "description": "Live warning/error/notice log lines from every quod node. Each node emits one JSON object per event to stdout (quod_log_formatter); promtail ships it as {job=\"docker\"} and Loki's | json exposes level/msg/node_id. node_id (kp_…) names the emitting instance — same id as the $node picker.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "expr": "{job=\"docker\"} |~ \"node_id\" | json | node_id=~\"kp_.+\" | level=~\"warning|error|notice\""
        }
      ]
    }
  ]
}
