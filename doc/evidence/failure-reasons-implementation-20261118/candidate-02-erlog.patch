 %% Do a deep dereference. Completely dereference all the variables
 %% occuring in a term, even those occuring in a variables value.
 
-dderef(A, _) when ?IS_CONSTANT(A) -> A;
-dderef([], _) -> [];
-dderef([H0|T0], Bs) ->
