+    Observe=fun(armed,{in,{'$gen_cast',{public_proof,_,_,execute,Goal,Request}}},_)
+                  when is_tuple(Request),tuple_size(Request)=:=7,
+                       element(1,Request)=:=proof_request,element(3,Request)=:=Principal ->
