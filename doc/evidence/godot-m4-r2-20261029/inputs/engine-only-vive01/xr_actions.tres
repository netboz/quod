[gd_resource type="OpenXRActionMap" format=3]

[sub_resource type="OpenXRAction" id="aim"]
resource_name = "aim"
localized_name = "aim"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="grip_pose"]
resource_name = "grip_pose"
localized_name = "grip pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="trigger_press"]
resource_name = "trigger_press"
localized_name = "trigger press"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="trigger_value"]
resource_name = "trigger_value"
localized_name = "trigger value"
action_type = 1
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="squeeze_press"]
resource_name = "squeeze_press"
localized_name = "squeeze press"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="pad_press"]
resource_name = "pad_press"
localized_name = "pad press"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="pad_touch"]
resource_name = "pad_touch"
localized_name = "pad touch"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="pad_axes"]
resource_name = "pad_axes"
localized_name = "pad axes"
action_type = 2
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRActionSet" id="inputs"]
resource_name = "quod_inputs"
localized_name = "Controller observations"
actions = [SubResource("aim"), SubResource("grip_pose"), SubResource("trigger_press"), SubResource("trigger_value"), SubResource("squeeze_press"), SubResource("pad_press"), SubResource("pad_touch"), SubResource("pad_axes")]

[sub_resource type="OpenXRIPBinding" id="aim_left"]
action = SubResource("aim")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="aim_right"]
action = SubResource("aim")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="grip_pose_left"]
action = SubResource("grip_pose")
binding_path = "/user/hand/left/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="grip_pose_right"]
action = SubResource("grip_pose")
binding_path = "/user/hand/right/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="trigger_press_left"]
action = SubResource("trigger_press")
binding_path = "/user/hand/left/input/trigger/click"

[sub_resource type="OpenXRIPBinding" id="trigger_press_right"]
action = SubResource("trigger_press")
binding_path = "/user/hand/right/input/trigger/click"

[sub_resource type="OpenXRIPBinding" id="trigger_value_left"]
action = SubResource("trigger_value")
binding_path = "/user/hand/left/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="trigger_value_right"]
action = SubResource("trigger_value")
binding_path = "/user/hand/right/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="squeeze_press_left"]
action = SubResource("squeeze_press")
binding_path = "/user/hand/left/input/squeeze/click"

[sub_resource type="OpenXRIPBinding" id="squeeze_press_right"]
action = SubResource("squeeze_press")
binding_path = "/user/hand/right/input/squeeze/click"

[sub_resource type="OpenXRIPBinding" id="pad_press_left"]
action = SubResource("pad_press")
binding_path = "/user/hand/left/input/trackpad/click"

[sub_resource type="OpenXRIPBinding" id="pad_press_right"]
action = SubResource("pad_press")
binding_path = "/user/hand/right/input/trackpad/click"

[sub_resource type="OpenXRIPBinding" id="pad_touch_left"]
action = SubResource("pad_touch")
binding_path = "/user/hand/left/input/trackpad/touch"

[sub_resource type="OpenXRIPBinding" id="pad_touch_right"]
action = SubResource("pad_touch")
binding_path = "/user/hand/right/input/trackpad/touch"

[sub_resource type="OpenXRIPBinding" id="pad_axes_left"]
action = SubResource("pad_axes")
binding_path = "/user/hand/left/input/trackpad"

[sub_resource type="OpenXRIPBinding" id="pad_axes_right"]
action = SubResource("pad_axes")
binding_path = "/user/hand/right/input/trackpad"

[sub_resource type="OpenXRInteractionProfile" id="vive"]
interaction_profile_path = "/interaction_profiles/htc/vive_controller"
bindings = [SubResource("aim_left"), SubResource("aim_right"), SubResource("grip_pose_left"), SubResource("grip_pose_right"), SubResource("trigger_press_left"), SubResource("trigger_press_right"), SubResource("trigger_value_left"), SubResource("trigger_value_right"), SubResource("squeeze_press_left"), SubResource("squeeze_press_right"), SubResource("pad_press_left"), SubResource("pad_press_right"), SubResource("pad_touch_left"), SubResource("pad_touch_right"), SubResource("pad_axes_left"), SubResource("pad_axes_right")]

[resource]
action_sets = [SubResource("inputs")]
interaction_profiles = [SubResource("vive")]

