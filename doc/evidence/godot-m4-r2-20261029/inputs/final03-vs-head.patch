+        } catch { if(entry.Active)Retire(entry);throw; }
+    }
+    public void ReleaseInstance(Node3D node)
+    { node.GetParent()?.RemoveChild(node);node.Free();InstancesReleased++; }
+    void Retire(Entry entry)
