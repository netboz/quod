+        readonly Entry entry;
+        readonly ModelAsset asset;
+        bool disposed;
+        private Lease(RenderModels owner,Entry entry,ModelAsset asset) { this.owner=owner;this.entry=entry;this.asset=asset; }
+        public async Task<Node3D?> Instantiate()
