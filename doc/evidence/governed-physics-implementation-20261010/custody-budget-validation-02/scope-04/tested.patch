+foreign_resource_deadline_cannot_withdraw_root_limits_test_() ->
+    {timeout, 60, fun() -> with_owner(fun(#{namespace := Ns, directory := Dir},
+                                         #{runtime := Runtime}) ->
+        {ok, Journal} = quod_effect_journal:start_link(#{data_dir => Dir}),
