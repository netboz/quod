                             <<"<<\"lobby-test-personal\">> :: (current_ontology_identity(<<\"lobby-test-personal\">>, <<\"\\xBB\\\\xB0\\\\xE5\\\\xA\\\\xDA\\~P\\xB3\\\\x98\\\\xDE\\\\xC5\\\\x15\\\\xB1\\\\xBD\\l\\x90\\b\\x98\\\\x9A\\T\\xF7\\r\\xE3\\\\x2\\\\xBD\\G\\xD9\\_\\xC2\\\\xD4\\\\xD8\\\\xDD\\\">>) , transaction(('$quod_predicate_source'(agent_hosted / 4, <<\"\">>) , '$quod_predicate_source'(physics_enabled / 2, <<\"\">>) , '$quod_program_source'(V0, <<\"%% Actor-instance rules. The founding ontology supplies its administrator,\\xA\\%% hosting policy and explicit signing grants. Messaging belongs to the domain.\\xA\\\\xA\\agent_identifier(Value) :- binary_codes(Value, Bytes), length(Bytes, 32).\\xA\\\\xA\\agent_hosted(Instance, NodeRef, Epoch, PublicKey) :-\\xA\\    findall(host(N, E, K), agent_host(Instance, N, E, K),\\xA\\            [host(NodeRef, Epoch, PublicKey)]),\\xA\\    findall(K, agent_key(Instance, K, active), [PublicKey]).\\xA\\\\xA\\%% The runtime supplies the requested resource scope and committed-policy\\xA\\%% context. It retains observed predicate dependencies for later invalidation.\\xA\\agent_hosting_projection(Requested, Node, Scope, Hosts) :-\\xA\\    agent_hosting_scope(Requested, Scope),\\xA\\    (Node \\\\= none ->\\xA\\        agent_hosting_instances(Scope, Node, Instances),\\xA\\        findall(host(I, Node, E, K),\\xA\\                (member(I, Instances), agent_hosted(I, Node, E, K), \\\\+ agent_hosting_suspended(I)), Hosts)\\xA\\    ; Hosts = []).\\xA\\\\xA\\agent_hosting_suspended(_) :- fail.\\xA\\\\xA\\agent_hosting_scope(agent(Instance), keys([Instance])).\\xA\\agent_hosting_scope(all, all).\\xA\\\\xA\\agent_hosting_instances(keys(Instances), _, Instances).\\xA\\agent_hosting_instances(all, Node, Instances) :-\\xA\\    findall(I, agent_host(I, Node, _, _), Local),\\xA\\    sort(Local, Instances).\\xA\\\\xA\\agent_work_after(start, _).\\xA\\agent_work_after(after(Previous), Key) :- Key @> Previous.\\xA\\\\xA\\action(initialize_agent_host(Instance, NodeRef, PublicKey),\\xA\\       [current_principal(Administrator),\\xA\\        can_assign_agent_host(Administrator, Instance, none, 0, NodeRef, PublicKey),\\xA\\        \\\\+ agent_host(Instance, _, _, _),\\xA\\        \\\\+ agent_key(Instance, _, _),\\xA\\        term_variables(Instance, []), term_variables(NodeRef, []),\\xA\\        agent_identifier(PublicKey)],\\xA\\       agent_hosted(Instance, NodeRef, 1, PublicKey)).\\xA\\\\xA\\initialize_agent_host(Instance, NodeRef, PublicKey) :-\\xA\\    assertz(agent_key(Instance, PublicKey, active)),\\xA\\    assertz(agent_host(Instance, NodeRef, 1, PublicKey)).\\xA\\\\xA\\%% The expected assignment is supplied by the request, never inferred by the\\xA\\%% desired-state planner. This prevents a stale recovery from rebasing a move.\\xA\\agent_assignment(Instance, OldNode, OldEpoch, NodeRef, Epoch, PublicKey) :-\\xA\\    term_variables(old(OldNode, OldEpoch), []),\\xA\\    integer(OldEpoch), Epoch is OldEpoch + 1,\\xA\\    agent_hosted(Instance, NodeRef, Epoch, PublicKey).\\xA\\\\xA\\action(assign_agent_host(Instance, OldNode, OldEpoch, NodeRef, Epoch, PublicKey),\\xA\\       [term_variables(old(OldNode, OldEpoch), []),\\xA\\        current_principal(Principal),\\xA\\        can_assign_agent_host(Principal, Instance, OldNode, OldEpoch, NodeRef, PublicKey),\\xA\\        agent_hosted(Instance, OldNode, OldEpoch, _OldKey),\\xA\\        integer(OldEpoch), Epoch is OldEpoch + 1,\\xA\\        term_variables(NodeRef, []), agent_identifier(PublicKey),\\xA\\        \\\\+ agent_key(Instance, PublicKey, _)],\\xA\\       agent_assignment(Instance, OldNode, OldEpoch, NodeRef, Epoch, PublicKey)).\\xA\\\\xA\\assign_agent_host(Instance, OldNode, OldEpoch, NodeRef, Epoch, PublicKey) :-\\xA\\    agent_hosted(Instance, OldNode, OldEpoch, OldKey),\\xA\\    retract(agent_host(Instance, OldNode, OldEpoch, OldKey)),\\xA\\    retract(agent_key(Instance, OldKey, active)),\\xA\\    assertz(agent_key(Instance, OldKey, revoked)),\\xA\\    assertz(agent_key(Instance, PublicKey, active)),\\xA\\    assertz(agent_host(Instance, NodeRef, Epoch, PublicKey)),\\xA\\    agent_retract_matching(agent_recovery_round(Instance, _, _, _)),\\xA\\    agent_retract_matching(agent_failure_report(Instance, _, _, _, _, _, _)),\\xA\\    agent_retract_matching(agent_candidate_key(Instance, _, _, _, _)).\\xA\\\\xA\\%% Recovery reports are current state, not an asserted event history. The\\xA\\%% containing ontology grants observer authority and decides takeover policy.\\xA\\%% Round and expected-report checks fence delayed reports and withdrawals.\\xA\\agent_recovery_current(Instance, NodeRef, Epoch, Round) :-\\xA\\    agent_hosted(Instance, NodeRef, Epoch, _),\\xA\\    findall(recovery(N, E, R), agent_recovery_round(Instance, N, E, R),\\xA\\            [recovery(NodeRef, Epoch, Round)]).\\xA\\\\xA\\action(begin_agent_recovery(Instance, NodeRef, Epoch, Round),\\xA\\       [current_principal(Observer),\\xA\\        can_report_agent_failure(Observer, Instance, NodeRef, begin),\\xA\\        agent_hosted(Instance, NodeRef, Epoch, _),\\xA\\        \\\\+ agent_recovery_round(Instance, _, _, _),\\xA\\        agent_identifier(Round)],\\xA\\       agent_recovery_current(Instance, NodeRef, Epoch, Round)).\\xA\\\\xA\\begin_agent_recovery(Instance, NodeRef, Epoch, Round) :-\\xA\\    assertz(agent_recovery_round(Instance, NodeRef, Epoch, Round)),\\xA\\    trigger_event(agent_recovery_started(Instance, NodeRef, Epoch, Round)).\\xA\\\\xA\\%% Explicit resolution is governed by domain policy, including how to resolve\\xA\\%% rounds whose observers have themselves disappeared. It grants no takeover.\\xA\\agent_recovery_resolved(Instance, NodeRef, Epoch, Round) :-\\xA\\    term_variables(recovery(Instance, NodeRef, Epoch, Round), []),\\xA\\    agent_hosted(Instance, NodeRef, Epoch, _),\\xA\\    \\\\+ agent_recovery_round(Instance, NodeRef, Epoch, Round).\\xA\\\\xA\\action(resolve_agent_recovery(Instance, NodeRef, Epoch, Round),\\xA\\       [term_variables(recovery(Instance, NodeRef, Epoch, Round), []),\\xA\\        current_principal(Principal),\\xA\\        can_resolve_agent_recovery(Principal, Instance, NodeRef, Epoch, Round),\\xA\\        agent_recovery_current(Instance, NodeRef, Epoch, Round)],\\xA\\       agent_recovery_resolved(Instance, NodeRef, Epoch, Round)).\\xA\\\\xA\\resolve_agent_recovery(Instance, NodeRef, Epoch, Round) :-\\xA\\    retract(agent_recovery_round(Instance, NodeRef, Epoch, Round)),\\xA\\    agent_retract_matching(agent_failure_report(Instance, NodeRef, Epoch, Round, _, _, _)).\\xA\\\\xA\\%% Custody is prepared by the destination principal and scoped to the current\\xA\\%% assignment. Private keys remain in that node's vault, never in ontology facts.\\xA\\action(prepare_agent_key(Instance, OldNode, OldEpoch, NodeRef, PublicKey),\\xA\\       [current_principal(NodeRef),\\xA\\        can_prepare_agent_key(NodeRef, Instance, OldNode, OldEpoch),\\xA\\        term_variables(old(OldNode, OldEpoch), []),\\xA\\        agent_hosted(Instance, OldNode, OldEpoch, _),\\xA\\        agent_identifier(PublicKey),\\xA\\        \\\\+ agent_key(Instance, PublicKey, _),\\xA\\        \\\\+ agent_candidate_key(Instance, OldNode, OldEpoch, NodeRef, _)],\\xA\\       agent_candidate_key(Instance, OldNode, OldEpoch, NodeRef, PublicKey)).\\xA\\\\xA\\prepare_agent_key(Instance, OldNode, OldEpoch, NodeRef, PublicKey) :-\\xA\\    assertz(agent_candidate_key(Instance, OldNode, OldEpoch, NodeRef, PublicKey)).\\xA\\\\xA\\%% These compositions run inside the caller's ordinary signed transaction.\\xA\\%% Check each action's postcondition before convergence consumes its state.\\xA\\%% A first report establishes its round in the same transaction. The producer\\xA\\%% captures ExpectedRound before observing: none cannot be rebased onto a\\xA\\%% competing round, and current(Round) cannot silently start another one.\\xA\\report_agent_observation(Instance, NodeRef, Epoch, ExpectedRound, Round, Observation, Kind) :-\\xA\\    term_variables(report(Instance, NodeRef, Epoch, ExpectedRound, Round, Observation, Kind), []),\\xA\\    agent_observation_round(ExpectedRound, Instance, NodeRef, Epoch, Round),\\xA\\    report_agent_and_converge(Instance, NodeRef, Epoch, Round, Observation, Kind),\\xA\\    (agent_recovery_current(Instance, NodeRef, Epoch, Round),\\xA\\     current_principal(Principal),\\xA\\     can_resolve_agent_recovery(Principal, Instance, NodeRef, Epoch, Round) ->\\xA\\        goal(agent_recovery_resolved(Instance, NodeRef, Epoch, Round))\\xA\\    ; true).\\xA\\\\xA\\%% A newly measured observation may supply its destination's stable custody in\\xA\\%% the same proof. Convergence follows reporting, after every prerequisite is\\xA\\%% present. Neither branch retries an earlier uncertain signed operation.\\xA\\report_agent_observation_with_custody(Instance, NodeRef, Epoch, ExpectedRound,\\xA\\                                      Round, Observation, Kind, Preparation) :-\\xA\\    term_variables(report(Instance, NodeRef, Epoch, ExpectedRound, Round,\\xA\\                           Observation, Kind, Preparation), []),\\xA\\    agent_observation_custody(Preparation, Instance, NodeRef, Epoch),\\xA\\    report_agent_observation(Instance, NodeRef, Epoch, ExpectedRound,\\xA\\                             Round, Observation, Kind).\\xA\\\\xA\\agent_observation_custody(prepared(PublicKey), Instance, OldNode, OldEpoch) :-\\xA\\    current_principal(Destination),\\xA\\    goal(agent_candidate_key(Instance, OldNode, OldEpoch, Destination, PublicKey)).\\xA\\agent_observation_custody(unavailable(_Reason), _, _, _).\\xA\\\\xA\\agent_observation_round(none, Instance, NodeRef, Epoch, Round) :-\\xA\\    \\\\+ agent_recovery_round(Instance, _, _, _),\\xA\\    goal(agent_recovery_current(Instance, NodeRef, Epoch, Round)).\\xA\\agent_observation_round(current(Round), Instance, NodeRef, Epoch, Round) :-\\xA\\    agent_recovery_current(Instance, NodeRef, Epoch, Round).\\xA\\\\xA\\report_agent_and_converge(Instance, NodeRef, Epoch, Round, Observation, Kind) :-\\xA\\    term_variables(report(Instance, NodeRef, Epoch, Round, Observation, Kind), []),\\xA\\    current_principal(Observer),\\xA\\    goal(agent_failure_report(Instance, NodeRef, Epoch, Round, Observer, Observation, Kind)),\\xA\\    converge_agent_assignment(Instance, NodeRef, Epoch, Round).\\xA\\\\xA\\prepare_agent_and_converge(Instance, OldNode, OldEpoch, NodeRef, PublicKey) :-\\xA\\    term_variables(preparation(Instance, OldNode, OldEpoch, NodeRef, PublicKey), []),\\xA\\    goal(agent_candidate_key(Instance, OldNode, OldEpoch, NodeRef, PublicKey)),\\xA\\    (agent_recovery_current(Instance, OldNode, OldEpoch, Round) ->\\xA\\        converge_agent_assignment(Instance, OldNode, OldEpoch, Round)\\xA\\    ; true).\\xA\\\\xA\\%% The containing ontology owns eligibility, observer threshold and ranking.\\xA\\%% Only a prepared key for this exact assignment may be selected. Sorting makes\\xA\\%% ties deterministic; the assignment action retains its ordinary authorization.\\xA\\converge_agent_assignment(Instance, OldNode, OldEpoch, Round) :-\\xA\\    term_variables(recovery(Instance, OldNode, OldEpoch, Round), []),\\xA\\    agent_recovery_current(Instance, OldNode, OldEpoch, Round),\\xA\\    current_principal(Principal),\\xA\\    findall(candidate(Rank, NodeRef, PublicKey),\\xA\\        (agent_candidate_key(Instance, OldNode, OldEpoch, NodeRef, PublicKey),\\xA\\         \\\\+ agent_key(Instance, PublicKey, _),\\xA\\         agent_recovery_candidate(Principal, Instance, OldNode, OldEpoch, Round, NodeRef, Rank),\\xA\\         term_variables(candidate(Rank, NodeRef, PublicKey), []),\\xA\\         can_assign_agent_host(Principal, Instance, OldNode, OldEpoch, NodeRef, PublicKey)),\\xA\\        Candidates),\\xA\\    sort(Candidates, Ranked),\\xA\\    agent_converge_candidate(Ranked, Instance, OldNode, OldEpoch).\\xA\\\\xA\\agent_converge_candidate([], _, _, _).\\xA\\agent_converge_candidate([candidate(_, NodeRef, PublicKey)|_], Instance, OldNode, OldEpoch) :-\\xA\\    Epoch is OldEpoch + 1,\\xA\\    goal(agent_assignment(Instance, OldNode, OldEpoch, NodeRef, Epoch, PublicKey)).\\xA\\\\xA\\%% Multiple current rows are malformed state, not a sequence to guess past.\\xA\\agent_report_next(Instance, NodeRef, Epoch, Round, Observer, Sequence) :-\\xA\\    findall(Observation,\\xA\\            agent_failure_report(Instance, NodeRef, Epoch, Round, Observer,\\xA\\                                 Observation, _),\\xA\\            Sequences),\\xA\\    agent_report_sequence(Sequences, Sequence).\\xA\\\\xA\\agent_report_sequence([], 1).\\xA\\agent_report_sequence([observation(Previous, _, _)], Sequence) :-\\xA\\    integer(Previous), Previous > 0, Sequence is Previous + 1.\\xA\\\\xA\\agent_observation_kind(process_down).\\xA\\agent_observation_kind(suspected_unreachable).\\xA\\agent_observation_kind(reachable).\\xA\\agent_observation_kind(withdrawing).\\xA\\\\xA\\agent_failure_kind(process_down).\\xA\\agent_failure_kind(suspected_unreachable).\\xA\\\\xA\\action(report_agent_failure(Instance, NodeRef, Epoch, Round,\\xA\\                            observation(Sequence, Observation, Expires), Kind),\\xA\\       [current_principal(Observer),\\xA\\        can_report_agent_failure(Observer, Instance, NodeRef, Kind),\\xA\\        agent_recovery_current(Instance, NodeRef, Epoch, Round),\\xA\\        agent_identifier(Observation), agent_observation_kind(Kind),\\xA\\        current_request_expiry(Expires),\\xA\\        agent_report_next(Instance, NodeRef, Epoch, Round, Observer, Sequence)],\\xA\\       agent_failure_report(Instance, NodeRef, Epoch, Round,\\xA\\                            Observer, observation(Sequence, Observation, Expires), Kind)).\\xA\\\\xA\\report_agent_failure(Instance, NodeRef, Epoch, Round, Observation, Kind) :-\\xA\\    current_principal(Observer),\\xA\\    agent_retract_matching(agent_failure_report(Instance, NodeRef, Epoch, Round, Observer, _, _)),\\xA\\    assertz(agent_failure_report(Instance, NodeRef, Epoch, Round, Observer, Observation, Kind)),\\xA\\    trigger_event(agent_failure_observed(Instance, NodeRef, Epoch, Round,\\xA\\                                         Observer, Observation, Kind)).\\xA\\\\xA\\%% A takeover request cannot outlive the signed observations it uses. This is\\xA\\%% a comparison of authenticated/committed data, not a live clock predicate.\\xA\\%% A containing ontology still supplies the observer set and threshold policy.\\xA\\agent_failure_support(Instance, NodeRef, Epoch, Round, Observer, Kind) :-\\xA\\    agent_failure_kind(Kind),\\xA\\    agent_report_support(Instance, NodeRef, Epoch, Round, Observer, Kind).\\xA\\\\xA\\agent_report_support(Instance, NodeRef, Epoch, Round, Observer, Kind) :-\\xA\\    agent_observation_kind(Kind),\\xA\\    agent_recovery_current(Instance, NodeRef, Epoch, Round),\\xA\\    current_request_expiry(RequestExpiry),\\xA\\    agent_failure_report(Instance, NodeRef, Epoch, Round, Observer, _, Kind),\\xA\\    findall(report(Observation, ReportKind),\\xA\\            agent_failure_report(Instance, NodeRef, Epoch, Round, Observer,\\xA\\                                 Observation, ReportKind),\\xA\\            [report(observation(_, _, ReportExpiry), Kind)]),\\xA\\    RequestExpiry =< ReportExpiry.\\xA\\\\xA\\can_sign_agent_request(Principal, NodeRef,\\xA\\                       agent_goal_v1(Network, AgentRef, InstanceText, PublicKey,\\xA\\                                     Operation, Deadline, Mode, Parser, GoalText)) :-\\xA\\    Principal = NodeRef,\\xA\\    AgentRef = agent_instance_ref(_, _, Instance),\\xA\\    agent_hosted(Instance, NodeRef, _, PublicKey),\\xA\\    can_request_agent_signature(Principal, Instance,\\xA\\        agent_goal_v1(Network, AgentRef, InstanceText, PublicKey,\\xA\\                      Operation, Deadline, Mode, Parser, GoalText)).\\xA\\\\xA\\agent_retract_matching(Pattern) :-\\xA\\    findall(Pattern, Pattern, Rows),\\xA\\    agent_retract_rows(Rows).\\xA\\\\xA\\agent_retract_rows([]).\\xA\\agent_retract_rows([Row|Rows]) :-\\xA\\    retract(Row),\\xA\\    agent_retract_rows(Rows).\\xA\\\\xA\\%% Optional physical worlds use explicitly assigned, independently hosted actors.\\xA\\%% Space policy supplies every allowance and hosting/signing grant.\\xA\\%% Distances are millimetres, time microseconds, density kg/m3.\\xA\\\\xA\\agent_hosting_suspended(I) :- physics_space(W, _, I), \\\\+ physics_enabled(W, I).\\xA\\\\xA\\%% Classification, enablement and configuration have one shared eligibility\\xA\\%% rule. Class membership by itself allocates nothing and grants no access.\\xA\\physics_enabled(W, I) :-\\xA\\    physics_space(W, enabled, I),\\xA\\    space_instance(W, physical_space),\\xA\\    findall(space(Mode, Actor), physics_space(W, Mode, Actor), [space(enabled, I)]),\\xA\\    physics_required_allowances(W, _, _, _, _).\\xA\\\\xA\\%% One authored body description, either owned geometry or an exact live source.\\xA\\%% Body identity, kind and placement belong to the admitting world; source shape\\xA\\%% and density never become a second mutable fact at that destination.\\xA\\physics_body_definition(_, _, _, _, _, _) :- fail.\\xA\\physics_resolve_definition(_, owned(Shape, Density), Shape, Density).\\xA\\physics_resolve_definition(W, live(entity_ref(Ns, Anchor, Entity), Assignment, Revision, Digest),\\xA\\                           Shape, Density) :-\\xA\\    physics_world_authority(W, World, Authority),\\xA\\    Ns::(current_ontology_identity(Ns, Anchor),\\xA\\         physics_definition_projection(World, Authority, Entity, Revision, geometry(Shape,Density)),\\xA\\         physics_definition_delegate(Entity, World, Authority, Assignment)),\\xA\\    term_digest(geometry(Shape,Density), Digest).\\xA\\\\xA\\physics_world_authority(W, world_ref(Ns, Anchor, W), agent_instance_ref(Ns, Anchor, I)) :-\\xA\\    current_ontology_identity(Ns, Anchor),\\xA\\    findall(A, physics_space(W, _, A), [I]).\\xA\\\\xA\\physics_definition(_, _, _) :- fail.\\xA\\physics_definition_delegate(_, _, _, _) :- fail.\\xA\\can_edit_physics_definition(_, _) :- fail.\\xA\\can_refresh_physics_definition(_, _, _) :- fail.\\xA\\can_delegate_physics_definition(_, _, _, _) :- fail.\\xA\\physics_definition_allowance(_, _) :- fail.\\xA\\physics_admission(_, _, _, _) :- fail.\\xA\\\\xA\\%% This pure, source-owned export is also evaluated over retained verified state.\\xA\\%% Installation delegation is not user invocation or disclosure permission.\\xA\\physics_definition_projection(World, Authority, Entity, Revision, Definition) :-\\xA\\    World = world_ref(Ns, Anchor, Space),\\xA\\    space_assignment(Entity, Assignment, entity_ref(Ns, Anchor, Space)),\\xA\\    findall(grant(W,A,R), physics_definition_delegate(Entity,W,A,R),\\xA\\            [grant(World,Authority,Assignment)]),\\xA\\    findall(definition(R,D), physics_definition(Entity,R,D),\\xA\\            [definition(Revision,Definition)]),\\xA\\    Definition = geometry(_, _).\\xA\\\\xA\\physics_delegate_definition(Entity, World, Authority, Assignment, Revision, Definition) :-\\xA\\    term_variables([Entity,World,Authority,Assignment], []),\\xA\\    transaction((current_principal(P),\\xA\\        can_delegate_physics_definition(Entity,P,World,Authority),\\xA\\        World = world_ref(Ns,Anchor,Space),\\xA\\        space_assignment(Entity,Assignment,entity_ref(Ns,Anchor,Space)),\\xA\\        \\\\+ physics_definition_delegate(Entity,_,_,_),\\xA\\        assertz(physics_definition_delegate(Entity,World,Authority,Assignment)),\\xA\\        physics_definition_projection(World,Authority,Entity,Revision,Definition))).\\xA\\\\xA\\physics_release_definition(Entity, World, Assignment) :-\\xA\\    term_variables([Entity,World,Assignment], []),\\xA\\    transaction((Next is Assignment + 1, space_assignment(Entity,Next,none),\\xA\\        findall(A,physics_definition_delegate(Entity,World,A,Assignment),[Authority]),\\xA\\        retract(physics_definition_delegate(Entity,World,Authority,Assignment)))).\\xA\\\\xA\\%% Simulated spaces compose this hook explicitly; ordinary unsimulated spaces\\xA\\%% retain their own space_physical_change/3 policy and allocate no native body.\\xA\\physics_space_change(W, Subject, admitted) :-\\xA\\    physics_enabled(W,_), physics_world_authority(W,World,Authority),\\xA\\    Subject = entity_ref(Ns,Anchor,Entity), physics_subscription(Ns,Anchor),\\xA\\    current_ontology_identity(Here,History),\\xA\\    findall(admission(K,P),physics_admission(W,Subject,K,P),[admission(Kind,Pose)]),\\xA\\    \\\\+ physics_body_definition(W,_,_,_,_,live(Subject,_,_,_)),\\xA\\    Ns::(current_ontology_identity(Ns,Anchor),\\xA\\         space_assignment(Entity,Assignment,entity_ref(Here,History,W)),\\xA\\         physics_delegate_definition(Entity,World,Authority,Assignment,Revision,geometry(Shape,Density))),\\xA\\    term_digest(geometry(Shape,Density),Digest),\\xA\\    physics_required_allowances(W,limits(_,_,_,Coordinate,_),_,_,_),\\xA\\    physics_body_capacity(W,1),\\xA\\    physics_allocate_body(W,Body), physics_checked_body(Body,Kind,Pose,Shape,Density,Coordinate),\\xA\\    physics_advance_structure(W,Next),\\xA\\    assertz(physics_body_definition(W,Body,Next,Kind,Pose,live(Subject,Assignment,Revision,Digest))).\\xA\\physics_space_change(W, Subject, withdrawn) :-\\xA\\    current_ontology_identity(Here,History), World = world_ref(Here,History,W),\\xA\\    findall(body(B,R,K,P,D),\\xA\\        (physics_body_definition(W,B,R,K,P,D),D = live(Subject,_,_,_)),\\xA\\        [body(Body,Revision,Kind,Pose,Definition)]),\\xA\\    Definition = live(Subject,Assignment,_,_), Subject = entity_ref(Ns,Anchor,Entity),\\xA\\    physics_removable_body(W,Body),\\xA\\    Ns::(current_ontology_identity(Ns,Anchor),\\xA\\         physics_release_definition(Entity,World,Assignment)),\\xA\\    physics_advance_structure(W,_),\\xA\\    retract(physics_body_definition(W,Body,Revision,Kind,Pose,Definition)),\\xA\\    physics_remove_rest_checkpoint(W,Body), physics_remove_rest_state(W,Body),\\xA\\    physics_remove_rest_request(W,Body).\\xA\\\\xA\\%% The subscription owner retains authored ground facts, not derived answers.\\xA\\physics_subscription(Ns,Anchor) :-\\xA\\    '$quod_predicate_source'(subscribes/2,Source),\\xA\\    '$quod_program_source'(Clauses,Source),\\xA\\    member((subscribes(S,A) :- true),Clauses), S == Ns, A == Anchor.\\xA\\\\xA\\physics_next_body(_, _) :- fail.\\xA\\physics_allocate_body(W, Body) :-\\xA\\    physics_body_allocator(W,Body),\\xA\\    physics_reserve_body_ids(W,[Body]).\\xA\\physics_reserve_body_ids(W, Bodies) :-\\xA\\    physics_body_allocator(W,Next),\\xA\\    sort(Bodies,Sorted), length(Bodies,Count), length(Sorted,Count),\\xA\\    physics_body_id_end(Sorted,Next,End),\\xA\\    retract(physics_next_body(W,Next)), assertz(physics_next_body(W,End)).\\xA\\physics_body_allocator(W,Next) :-\\xA\\    (findall(N,physics_next_body(W,N),[Next]), integer(Next), Next >= 0 -> true\\xA\\    ; fail_with_reason(body_allocator_missing(W))).\\xA\\physics_body_id_end([], Next, Next).\\xA\\physics_body_id_end([B|Bodies], Next, End) :-\\xA\\    (integer(B), B >= Next, B < 18446744073709551616 -> true\\xA\\    ; fail_with_reason(body_identity_unavailable(B))),\\xA\\    Following is B + 1, physics_body_id_end(Bodies,Following,End).\\xA\\physics_body_capacity(W,Additional) :-\\xA\\    physics_required_allowances(W,limits(Max,_,_,_,_),_,_,_),\\xA\\    findall(B,physics_body_definition(W,B,_,_,_,_),Bodies), length(Bodies,Count),\\xA\\    (Count + Additional =< Max -> true ; fail_with_reason(body_allowance(Max))).\\xA\\physics_advance_structure(W,Next) :-\\xA\\    findall(S,physics_structure(W,S),[Before]), Next is Before + 1,\\xA\\    retract(physics_structure(W,Before)), assertz(physics_structure(W,Next)).\\xA\\\\xA\\%% Replacing an authority changes every live source delegation in the same\\xA\\%% signed transition. Host/key assignment remains the existing agent lifecycle.\\xA\\physics_assign_authority(W, Before, After) :-\\xA\\    term_variables([W,Before,After], []), Before \\\\== After,\\xA\\    transaction((current_principal(P), can_edit_physics(W,P),\\xA\\        findall(space(M,I),physics_space(W,M,I),[space(Mode,Before)]),\\xA\\        agent_hosted(After,_,_,_), physics_run(W,Generation,_),\\xA\\        physics_custody(W,Custody), physics_previous_complete(Custody,Generation),\\xA\\        current_ontology_identity(Ns,Anchor),\\xA\\        findall(live(S,A,R,D),physics_body_definition(W,_,_,_,_,live(S,A,R,D)),References),\\xA\\        retract(physics_space(W,Mode,Before)), assertz(physics_space(W,Mode,After)),\\xA\\        physics_redelegate_sources(References,world_ref(Ns,Anchor,W),\\xA\\            agent_instance_ref(Ns,Anchor,Before),agent_instance_ref(Ns,Anchor,After)))).\\xA\\\\xA\\physics_redelegate_sources([],_,_,_).\\xA\\physics_redelegate_sources([live(entity_ref(Ns,Anchor,Entity),Assignment,_,_)|Rest],World,Before,After) :-\\xA\\    Ns::(current_ontology_identity(Ns,Anchor),\\xA\\         physics_redelegate_definition(Entity,World,Before,After,Assignment)),\\xA\\    physics_redelegate_sources(Rest,World,Before,After).\\xA\\physics_redelegate_definition(Entity,World,Before,After,Assignment) :-\\xA\\    term_variables([Entity,World,Before,After,Assignment], []),\\xA\\    transaction((current_principal(P), can_delegate_physics_definition(Entity,P,World,After),\\xA\\        World = world_ref(Ns,Anchor,Space),\\xA\\        space_assignment(Entity,Assignment,entity_ref(Ns,Anchor,Space)),\\xA\\        Ns::(current_ontology_identity(Ns,Anchor), physics_world_authority(Space,World,After)),\\xA\\        findall(grant(W,A,R),physics_definition_delegate(Entity,W,A,R),[grant(World,Before,Assignment)]),\\xA\\        retract(physics_definition_delegate(Entity,World,Before,Assignment)),\\xA\\        assertz(physics_definition_delegate(Entity,World,After,Assignment)))).\\xA\\\\xA\\physics_edit_definition(Entity, Expected, Definition) :-\\xA\\    term_variables([Entity,Expected,Definition], []),\\xA\\    transaction((current_principal(P), can_edit_physics_definition(Entity,P),\\xA\\        findall(definition(R,D),physics_definition(Entity,R,D),[definition(Expected,Before)]),\\xA\\        Definition = geometry(Shape,Density),\\xA\\        findall(C,physics_definition_allowance(Entity,C),[Coordinate]),\\xA\\        physics_checked_body(0,fixed,vector(0,0,0),Shape,Density,Coordinate),\\xA\\        Next is Expected + 1,\\xA\\        retract(physics_definition(Entity,Expected,Before)),\\xA\\        assertz(physics_definition(Entity,Next,Definition)),\\xA\\        physics_definition_consequence(Entity,Expected,Next,Definition))).\\xA\\\\xA\\physics_definition_consequence(Entity,Before,Next,Definition) :-\\xA\\    findall(grant(W,A,R),physics_definition_delegate(Entity,W,A,R),Grants),\\xA\\    (Grants = [] -> true\\xA\\    ; Grants = [grant(world_ref(Ns,Anchor,Space),_,Assignment)],\\xA\\      space_assignment(Entity,Assignment,entity_ref(Ns,Anchor,Space)),\\xA\\      current_ontology_identity(Here,History),\\xA\\      Ns::(current_ontology_identity(Ns,Anchor),\\xA\\           physics_refresh_definition(Space,entity_ref(Here,History,Entity),Assignment,Before,Next,Definition))).\\xA\\\\xA\\physics_refresh_definition(W,Subject,Assignment,Before,Next,Definition) :-\\xA\\    term_variables([W,Subject,Assignment,Before,Next,Definition], []),\\xA\\    transaction((current_principal(P), can_refresh_physics_definition(W,P,Subject),\\xA\\        space_placement(W,Subject,Assignment), Next is Before + 1,\\xA\\        physics_world_authority(W,World,Authority), Subject = entity_ref(Ns,Anchor,Entity),\\xA\\        Ns::(current_ontology_identity(Ns,Anchor),\\xA\\             physics_definition_projection(World,Authority,Entity,Next,Definition)),\\xA\\        findall(body(B,R,K,Position,D),\\xA\\            (physics_body_definition(W,B,R,K,Position,D),D = live(Subject,Assignment,Before,_)),\\xA\\            [body(Body,Revision,Kind,Pose,Old)]),\\xA\\        physics_unconstrained_body(W,Body),\\xA\\        physics_required_allowances(W,limits(_,_,_,Coordinate,_),_,_,_),\\xA\\        Definition = geometry(Shape,Density),\\xA\\        physics_checked_body(Body,Kind,Pose,Shape,Density,Coordinate), term_digest(Definition,Digest),\\xA\\        physics_advance_structure(W,Structure),\\xA\\        retract(physics_body_definition(W,Body,Revision,Kind,Pose,Old)),\\xA\\        assertz(physics_body_definition(W,Body,Structure,Kind,Pose,live(Subject,Assignment,Next,Digest))),\\xA\\        physics_remove_rest_checkpoint(W,Body), physics_cancel_rest_edit(W,Body))).\\xA\\\\xA\\physics_delete_definition(Entity, Expected) :-\\xA\\    term_variables([Entity,Expected], []),\\xA\\    transaction((current_principal(P), can_edit_physics_definition(Entity,P),\\xA\\        findall(D,physics_definition(Entity,Expected,D),[Before]),\\xA\\        space_assignment(Entity,Assignment,Destination),\\xA\\        (Destination = none -> true ; space_withdraw(Entity,Assignment,Destination)),\\xA\\        retract(physics_definition(Entity,Expected,Before)), Next is Expected + 1,\\xA\\        assertz(physics_definition(Entity,Next,none)))).\\xA\\\\xA\\physics_unconstrained_body(W,B) :-\\xA\\    (\\\\+ physics_joint(W,hinge(B,_,_,_,_,_)), \\\\+ physics_joint(W,hinge(_,_,B,_,_,_)) -> true\\xA\\    ; fail_with_reason(body_constraint_group(B))).\\xA\\physics_removable_body(W,B) :-\\xA\\    physics_unconstrained_body(W,B),\\xA\\    (\\\\+ physics_agent(W,_,_,B,_) -> true ; fail_with_reason(body_agent_binding(B))),\\xA\\    physics_rest_custody(W,B,Custody),\\xA\\    (Custody = none -> true\\xA\\    ; Custody = request(_,_,Bytes,Signature),\\xA\\      committed_operation_outcome(Bytes,Signature,Status), member(Status,[committed,rejected,aborted])).\\xA\\\\xA\\%% A domain supplies one local view and its ordinary principal policy. Marks\\xA\\%% name occurrences; only body_pose/2 names their physical source. Live samples\\xA\\%% never validate a durable transaction.\\xA\\can_view_physics(_, _) :- fail.\\xA\\can_read_physics_body(_, _, _) :- fail.\\xA\\can_query_physics_motion(_, _, _, _) :- fail.\\xA\\physics_query_allowances(_, _, _) :- fail.\\xA\\\\xA\\%% The live bridge enters this policy in an immutable read-only proof. The\\xA\\%% returned frame names committed authority; only its installed owner can\\xA\\%% supply the corresponding current pose.\\xA\\physics_body_read_projection(W, Body, Frame, Revision) :-\\xA\\    current_principal(Principal), can_read_physics_body(W, Principal, Body),\\xA\\    physics_body_projection(W, Body, Frame, Revision).\\xA\\\\xA\\physics_motion_read_projection(W, Body, Query, Frame, Revision,\\xA\\        query_limits(Skin, Tolerance, Slides, Checks)) :-\\xA\\    current_principal(Principal), can_query_physics_motion(W, Principal, Body, Query),\\xA\\    physics_required_configuration(Q, physics_query_allowances(W, Principal, Q),\\xA\\        query_allowances(Skin, Tolerance, Slides, Checks, Travel, Turn),\\xA\\        query_allowances_missing(W)),\\xA\\    integer(Skin), Skin > 0, integer(Tolerance), Tolerance >= 0, Tolerance < Skin,\\xA\\    integer(Slides), Slides > 0, integer(Checks), Checks > 0,\\xA\\    integer(Travel), Travel > 0, integer(Turn), Turn > 0,\\xA\\    physics_required_allowances(W, limits(_, _, _, Coordinate, _), _, _, _),\\xA\\    physics_query_input(Query, Coordinate, Travel, Turn),\\xA\\    physics_body_projection(W, Body, Frame, Revision).\\xA\\\\xA\\physics_required_allowances(W, Limits, Step, Gravity, Budget) :-\\xA\\    physics_configuration_rows(allowances(L,S,G,B), physics_allowances(W,L,S,G,B),\\xA\\        allowances_missing(W), Rows),\\xA\\    (Rows = [allowances(Limits,Step,Gravity,Budget)] -> true\\xA\\    ; fail_with_reason(ambiguous_physics_configuration)).\\xA\\\\xA\\physics_required_configuration(Template, Goal, Requested, Missing) :-\\xA\\    physics_configuration_rows(Template, Goal, Missing, Rows), member(Requested, Rows).\\xA\\\\xA\\physics_configuration_rows(Template, Goal, Missing, Rows) :-\\xA\\    findall(Template, Goal, Rows),\\xA\\    (Rows = [] -> fail_with_reason(Missing) ; true).\\xA\\\\xA\\physics_query_input(place(pose(Position, rotation(X,Y,Z))), Coordinate, _, Turn) :-\\xA\\    physics_query_vector(Position, Coordinate), physics_query_vector(vector(X,Y,Z), Turn).\\xA\\physics_query_input(travel(Translation, angular(X,Y,Z)), _, Travel, Turn) :-\\xA\\    physics_query_vector(Translation, Travel), physics_query_vector(vector(X,Y,Z), Turn).\\xA\\physics_query_input(landing(Position, Reach, Drop, Up), Coordinate, Travel, _) :-\\xA\\    physics_query_vector(Position, Coordinate),\\xA\\    physics_landing_parameters(Reach, Drop, Up), Reach =< Travel, Drop =< Travel.\\xA\\physics_landing_parameters(Reach, Drop, Up) :-\\xA\\    integer(Reach), Reach > 0, integer(Drop), Drop > 0,\\xA\\    integer(Up), Up > 0, Up =< 1000.\\xA\\physics_query_vector(vector(X,Y,Z), Limit) :-\\xA\\    physics_coordinate(X, Limit), physics_coordinate(Y, Limit), physics_coordinate(Z, Limit).\\xA\\\\xA\\physics_body_projection(W, Body,\\xA\\        physics_frame(world_ref(Ns, Anchor, W), agent_instance_ref(Ns, Anchor, I),\\xA\\                      Epoch, Generation, Token, Structure), Revision) :-\\xA\\    current_ontology_identity(Ns, Anchor), physics_enabled(W, I),\\xA\\    agent_hosted(I, _, Epoch, _), physics_run(W, Generation, Token), Generation > 0,\\xA\\    physics_structure(W, Structure), physics_body_definition(W, Body, Revision, _, _, _).\\xA\\\\xA\\%% Physical agents and viewpoints are domain definitions. Binding a principal\\xA\\%% selects an existing agent; it never creates a body or changes the signer.\\xA\\physics_agent(_, _, _, _, _) :- fail.\\xA\\physics_viewpoint(_, _, _, _, _, _) :- fail.\\xA\\physics_control(_, _, _, _) :- fail.\\xA\\can_control_physics_agent(_, _, _) :- fail.\\xA\\\\xA\\physics_control_state(W, Principal, Epoch, Selection) :-\\xA\\    findall(control(E, S), physics_control(W, Principal, E, S), Rows),\\xA\\    (Rows = [] -> Epoch = 0, Selection = none\\xA\\    ; Rows = [control(E, S)] -> Epoch = E, Selection = S\\xA\\    ; fail_with_reason(ambiguous_control(W))).\\xA\\\\xA\\physics_control_agent(W, ExpectedEpoch, ExpectedSelection, Selection) :-\\xA\\    term_variables([W, ExpectedEpoch, ExpectedSelection, Selection], []),\\xA\\    integer(ExpectedEpoch), ExpectedEpoch >= 0,\\xA\\    transaction((current_principal(Principal), physics_space(W, _, _),\\xA\\        physics_control_state(W, Principal, Epoch, Current),\\xA\\        (Epoch = ExpectedEpoch, Current = ExpectedSelection -> true\\xA\\        ; fail_with_reason(control_conflict(Epoch))),\\xA\\        physics_control_choice(W, Principal, Selection),\\xA\\        (ExpectedEpoch = 0, ExpectedSelection = none,\\xA\\         \\\\+ physics_control(W, Principal, _, _) -> true\\xA\\        ; retract(physics_control(W, Principal, ExpectedEpoch, ExpectedSelection))),\\xA\\        Next is ExpectedEpoch + 1,\\xA\\        assertz(physics_control(W, Principal, Next, Selection)))).\\xA\\\\xA\\physics_control_choice(_, _, none).\\xA\\physics_control_choice(W, Principal, controlled(Agent, Viewpoint)) :-\\xA\\    physics_agent_configuration(W, Principal, Agent, Viewpoint, _),\\xA\\    (\\\\+ (physics_control(W, Other, _, controlled(Agent, _)),\\xA\\        Other \\\\== Principal) -> true ; fail_with_reason(agent_controlled(Agent))).\\xA\\\\xA\\%% Exact singleton definitions fail closed on ambiguous authored configuration.\\xA\\%% Pose/motion schema and supported mechanics are checked by the installing\\xA\\%% adapter, never inferred from an Eidolon or the human's device dimensions.\\xA\\physics_agent_configuration(W, Principal, Agent, Viewpoint, Configuration) :-\\xA\\    Configuration = controlled_agent(Agent, _, _, _, _, viewpoint(Viewpoint, _, _)),\\xA\\    can_control_physics_agent(W, Principal, Agent),\\xA\\    once((instance_of(Class, Agent), (Class = agent ; isa(Class, agent)))),\\xA\\    (findall(definition(R, B, M), physics_agent(W, Agent, R, B, M),\\xA\\            [definition(Revision, Body, Motion)]),\\xA\\     findall(A, physics_agent(W, A, _, Body, _), [Agent]),\\xA\\     findall(R, physics_body_definition(W, Body, R, _, _, _), [BodyRevision]),\\xA\\     findall(mount(B, Pose, Track), physics_viewpoint(W, Agent, Viewpoint, B, Pose, Track),\\xA\\            [mount(Body, LocalPose, Tracking)]) -> true\\xA\\    ; fail_with_reason(ambiguous_agent(Agent))),\\xA\\    integer(Revision), Revision > 0,\\xA\\    term_variables([Agent, Viewpoint, Body, Motion, LocalPose, Tracking], []),\\xA\\    Configuration = controlled_agent(Agent, Revision, Body, BodyRevision, Motion,\\xA\\                                    viewpoint(Viewpoint, LocalPose, Tracking)).\\xA\\\\xA\\physics_control_configuration(W, Principal, Epoch, Configuration) :-\\xA\\    physics_control_state(W, Principal, Epoch, controlled(Agent, Viewpoint)),\\xA\\    integer(Epoch), Epoch > 0,\\xA\\    physics_agent_configuration(W, Principal, Agent, Viewpoint, Configuration).\\xA\\\\xA\\%% This signed read describes domain selection, not native readiness. The\\xA\\%% simulation endpoint still has to bind the installed run and owner.\\xA\\physics_client_control(W, control(Epoch,\\xA\\        controlled_agent(agent_instance_ref(Ns, Anchor, Agent), R, B, BR, Motion, View))) :-\\xA\\    current_principal(Principal), can_view_physics(W, Principal),\\xA\\    current_ontology_identity(Ns, Anchor),\\xA\\    physics_control_configuration(W, Principal, Epoch, controlled_agent(Agent, R, B, BR, Motion, View)).\\xA\\\\xA\\%% A signed control proof reads committed policy and stages one live input.\\xA\\%% Camera/tracking offsets never enter this motion descriptor.\\xA\\physics_input_projection(W, control_frame(Frame, Registration), Epoch, Sequence, Input, Control, Lease, Limits) :-\\xA\\    agent_identifier(Registration), integer(Sequence), Sequence >= 0, current_principal(Principal),\\xA\\    physics_input_control(W, Principal, Epoch, Configuration),\\xA\\    physics_input_limits(W, Principal, Configuration, Frame, Input, Lease, Limits),\\xA\\    Control = control(Principal, Epoch, Configuration).\\xA\\\\xA\\physics_input_limits(W, _, Configuration, Frame, Input, Lease, Limits) :-\\xA\\    Configuration = controlled_agent(_, _, Body, Revision, Motion, _),\\xA\\    Motion = motion(Mode, Speed, Turn, Lease, Limits, Capabilities),\\xA\\    physics_motion_mode(Mode), physics_motion_capabilities(Capabilities, []),\\xA\\    integer(Speed), Speed > 0, integer(Turn), Turn > 0,\\xA\\    integer(Lease), Lease > 0,\\xA\\    Limits = query_limits(Skin, Tolerance, Slides, Checks),\\xA\\    integer(Skin), Skin > 0, integer(Tolerance), Tolerance >= 0, Tolerance < Skin,\\xA\\    integer(Slides), Slides > 0, integer(Checks), Checks > 0,\\xA\\    physics_allowed_input(Input, Mode, Speed, Turn, Capabilities),\\xA\\    physics_required_allowances(W, limits(_, _, _, Coordinate, _), _, _, _),\\xA\\    physics_absolute_input(Input, Coordinate),\\xA\\    physics_body_projection(W, Body, Frame, Revision),\\xA\\    physics_body_definition(W, Body, Revision, controlled, _, _).\\xA\\\\xA\\physics_input_control(W, Principal, Epoch, Configuration) :-\\xA\\    physics_control_state(W, Principal, Current, Selection),\\xA\\    (Selection = controlled(Agent, Viewpoint) -> true ; fail_with_reason(no_control(W))),\\xA\\    (Epoch = Current -> true ; fail_with_reason(control_conflict(Current))),\\xA\\    physics_agent_configuration(W, Principal, Agent, Viewpoint, Configuration).\\xA\\\\xA\\can_push_physics_body(_, _, _) :- fail.\\xA\\physics_push_allowances(_, _, _, _) :- fail.\\xA\\\\xA\\physics_push_configuration(W, Principal, Body, Revision, MaxImpulse, MaxSpeed) :-\\xA\\    can_push_physics_body(W, Principal, Body),\\xA\\    physics_free_body(W, Body, Revision),\\xA\\    physics_required_configuration(P, physics_push_allowances(W, Principal, Body, P),\\xA\\        push_limits(MaxImpulse, MaxSpeed), push_allowances_missing(Body)),\\xA\\    integer(MaxImpulse), MaxImpulse > 0, integer(MaxSpeed), MaxSpeed > 0.\\xA\\\\xA\\physics_free_body(W, Body, Revision) :-\\xA\\    physics_body_definition(W, Body, Revision, dynamic, _, _),\\xA\\    \\\\+ physics_joint(W, hinge(Body, _, _, _, _, _)),\\xA\\    \\\\+ physics_joint(W, hinge(_, _, Body, _, _, _)).\\xA\\\\xA\\physics_input_limits(W, Principal, Configuration, Frame,\\xA\\        push(body(Body, Revision), vector(X,Y,Z)), Lease,\\xA\\        push_limits(Body, Revision, MaxImpulse, MaxSpeed)) :-\\xA\\    Configuration = controlled_agent(_, _, _, _, motion(_, _, _, Lease, _, _), _),\\xA\\    integer(Lease), Lease > 0,\\xA\\    physics_push_configuration(W, Principal, Body, Revision, MaxImpulse, MaxSpeed),\\xA\\    physics_query_vector(vector(X,Y,Z), MaxImpulse),\\xA\\    X*X+Y*Y+Z*Z > 0, X*X+Y*Y+Z*Z =< MaxImpulse*MaxImpulse,\\xA\\    physics_body_projection(W, Body, Frame, Revision).\\xA\\\\xA\\physics_motion_mode(free).\\xA\\physics_motion_mode(grounded(Up)) :- integer(Up), Up > 0, Up =< 1000.\\xA\\physics_motion_capabilities([], _).\\xA\\physics_motion_capabilities([teleport(Reach, Drop, Up) | Rest], Seen) :-\\xA\\    \\\\+ member(teleport, Seen), physics_landing_parameters(Reach, Drop, Up),\\xA\\    physics_motion_capabilities(Rest, [teleport | Seen]).\\xA\\physics_motion_capabilities([snap(Step) | Rest], Seen) :-\\xA\\    \\\\+ member(snap, Seen), integer(Step), Step > 0, Step =< 3141,\\xA\\    physics_motion_capabilities(Rest, [snap | Seen]).\\xA\\physics_motion_capabilities([reposition | Rest], Seen) :-\\xA\\    \\\\+ member(reposition, Seen), physics_motion_capabilities(Rest, [reposition | Seen]).\\xA\\physics_absolute_input(reposition(Pose), Coordinate) :-\\xA\\    physics_query_input(place(Pose), Coordinate, Coordinate, Coordinate).\\xA\\physics_absolute_input(teleport(Position), Coordinate) :- physics_query_vector(Position, Coordinate).\\xA\\physics_absolute_input(drive(_, _), _).\\xA\\physics_absolute_input(snap(_), _).\\xA\\physics_allowed_input(drive(vector(X,Y,Z), angular(Ax,Ay,Az)), Mode, Speed, Turn, _) :-\\xA\\    physics_query_vector(vector(X,Y,Z), Speed),\\xA\\    physics_query_vector(vector(Ax,Ay,Az), Turn),\\xA\\    X*X+Y*Y+Z*Z =< Speed*Speed, Ax*Ax+Ay*Ay+Az*Az =< Turn*Turn,\\xA\\    (Mode = grounded(_) -> Y = 0 ; true).\\xA\\physics_allowed_input(teleport(vector(X,Y,Z)), grounded(_), _, _, Capabilities) :-\\xA\\    integer(X), integer(Y), integer(Z),\\xA\\    member(teleport(Reach, Drop, Up), Capabilities), physics_landing_parameters(Reach, Drop, Up).\\xA\\physics_allowed_input(snap(Angle), _, _, _, Capabilities) :-\\xA\\    integer(Angle), member(snap(Step), Capabilities),\\xA\\    integer(Step), Step > 0, Step =< 3141, (Angle = Step ; Angle =:= -Step).\\xA\\%% Explicit corrective relocation is a separate authored capability. It tests\\xA\\%% occupancy but may leave an invalid initial placement without a travel path.\\xA\\%% Like locomotion, it changes live pose; it does not rewrite a durable baseline.\\xA\\physics_allowed_input(reposition(_), _, _, _, Capabilities) :- member(reposition, Capabilities).\\xA\\\\xA\\physics_client_view(W, Marks, Selection) :-\\xA\\    current_principal(P),\\xA\\    physics_control_state(W, P, Binding, BindingSelection),\\xA\\    physics_view_selection(W, P, Binding, BindingSelection, Marks, Selection).\\xA\\\\xA\\physics_view_selection(W, P, Binding, BindingSelection, Marks, Selection) :-\\xA\\    (can_view_physics(W, P) ->\\xA\\        (findall(space(M, A), physics_space(W, M, A), [space(Mode, I)]) ->\\xA\\            (Mode = disabled -> Selection = disabled\\xA\\            ; BindingSelection = controlled(Agent, _),\\xA\\              \\\\+ can_control_physics_agent(W, P, Agent) -> Selection = denied\\xA\\            ; Mode = enabled, physics_enabled(W, I), physics_view_bodies(Marks, W),\\xA\\              physics_selected_control(W, P, Binding, BindingSelection, Control) ->\\xA\\                physics_active_selection(W, I, Control, Selection)\\xA\\            ; Selection = unavailable)\\xA\\        ; Selection = unavailable)\\xA\\    ; Selection = denied).\\xA\\\\xA\\physics_selected_control(_, _, _, none, none).\\xA\\physics_selected_control(W, P, Binding, controlled(_, _), control(P, Binding, Configuration)) :-\\xA\\    physics_control_configuration(W, P, Binding, Configuration).\\xA\\\\xA\\physics_active_selection(W, I, Control, Selection) :-\\xA\\    current_ontology_identity(Ns, Anchor),\\xA\\    findall(S, physics_structure(W, S), [Structure]),\\xA\\    findall(run(G, T), physics_run(W, G, T), Runs),\\xA\\    findall(E, agent_hosted(I, _, E, _), Hosts),\\xA\\    (Runs = [run(Generation, Token)], Hosts = [Epoch], Generation > 0 ->\\xA\\        Selection = simulation_view(world_ref(Ns, Anchor, W),\\xA\\            agent_instance_ref(Ns, Anchor, I), Epoch, Generation, Token, Structure, Control)\\xA\\    ; (Runs = []; Runs = [run(0, none)]; Hosts = []) -> Selection = recovering\\xA\\    ; Selection = unavailable).\\xA\\\\xA\\physics_view_bodies([], _).\\xA\\physics_view_bodies([mark(_, _, _, Pose, _, _, Depicts) | Rest], W) :-\\xA\\    physics_view_body(Pose, Depicts, W), physics_view_bodies(Rest, W).\\xA\\\\xA\\%% Decorative occurrences keep their authored frames. Only an explicit body\\xA\\%% source receives native poses; its subject may live in another ontology.\\xA\\physics_view_body(relative(_, Pose), Depicts, W) :- physics_view_body(Pose, Depicts, W).\\xA\\physics_view_body(transform(_, _, _, _, _, _), _, _).\\xA\\physics_view_body(body_pose(B, R), depicts(_, _, _), W) :- physics_body_definition(W, B, R, _, _, _).\\xA\\\\xA\\physics_projection(Node, Rows) :-\\xA\\    findall(world(W, I, Epoch, Key, Generation, RunToken, Custody, Structure,\\xA\\                  Limits, StepUs, Gravity, Bodies, Budget,\\xA\\                  baseline(Checkpoints, Joints, Activities, control_selection(Bindings, Controls))),\\xA\\      (physics_enabled(W, I), agent_hosted(I, Node, Epoch, Key),\\xA\\       physics_run(W, Generation, RunToken), physics_structure(W, Structure),\\xA\\       physics_required_allowances(W, Limits, StepUs, Gravity, Budget),\\xA\\       physics_custody(W, Custody),\\xA\\       findall(C, physics_recovery_checkpoint(W, C), Checkpoints),\\xA\\       findall(J, physics_joint(W, J), Joints),\\xA\\       findall(door(D, Sequence, State, Request),\\xA\\               (physics_door(W,D,Sequence,State), physics_door_custody(W,D,Request)), Doors),\\xA\\       findall(rest(D, Sequence, State, Request),\\xA\\               (physics_rest(W,D,Sequence,State), physics_rest_custody(W,D,Request)), Rests),\\xA\\       append(Doors, Rests, Activities),\\xA\\       findall(binding(Principal, BindingEpoch, Selection),\\xA\\               physics_control(W, Principal, BindingEpoch, Selection), Bindings),\\xA\\       findall(control(Principal, ControlEpoch, Configuration),\\xA\\               (physics_control(W, Principal, _, controlled(_, _)),\\xA\\                physics_control_configuration(W, Principal, ControlEpoch, Configuration)), AgentControls),\\xA\\       findall(push(Principal, Body, Revision, MaxImpulse, MaxSpeed),\\xA\\               (physics_control(W, Principal, _, controlled(_, _)),\\xA\\                physics_push_configuration(W, Principal, Body, Revision, MaxImpulse, MaxSpeed)), Pushes),\\xA\\       append(AgentControls, Pushes, Controls),\\xA\\       findall(body(Id, Rev, Kind, Pose, Definition),\\xA\\               physics_body_definition(W, Id, Rev, Kind, Pose, Definition), Bodies)), Rows).\\xA\\\\xA\\physics_custody(W, Custody) :-\\xA\\    findall(R, physics_request(W, R), Requests),\\xA\\    (Requests = [] -> Custody = none ; Requests = [Custody]).\\xA\\\\xA\\physics_actor(W) :-\\xA\\    physics_enabled(W, I), current_ontology_identity(Ns, Anchor),\\xA\\    current_principal(agent_instance_ref(Ns, Anchor, I)),\\xA\\    agent_hosted(I, _, _, _).\\xA\\\\xA\\%% The original signed activation is durable before submission. Its exact\\xA\\%% request remains available after actor, runtime or host loss. This is domain\\xA\\%% work in the existing ontology transaction lane, not a local outbox.\\xA\\physics_store_request(W, Generation, Prior, Token, Bytes, Signature) :-\\xA\\    transaction((physics_actor(W), physics_run(W, Generation, _),\\xA\\        physics_custody(W, Prior), physics_previous_complete(Prior, Generation), agent_identifier(Token),\\xA\\        signed_physics_request(physics_activate(W, Generation, Token), Bytes, Signature),\\xA\\        \\\\+ physics_cancelled_request(W, request(Token, Generation, Bytes, Signature)),\\xA\\        (Prior = none -> true ; retract(physics_request(W, Prior))),\\xA\\        assertz(physics_request(W, request(Token, Generation, Bytes, Signature))))).\\xA\\\\xA\\physics_activate(W, Generation, Token) :-\\xA\\    transaction((physics_actor(W), physics_run(W, Generation, Previous),\\xA\\        physics_request(W, request(Token, Generation, Bytes, Signature)),\\xA\\        current_signed_request(Bytes, Signature),\\xA\\        retract(physics_run(W, Generation, Previous)), Next is Generation + 1,\\xA\\        assertz(physics_run(W, Next, Token)))).\\xA\\\\xA\\%% A pending request cannot be overwritten merely because its result is late.\\xA\\physics_previous_complete(none, _).\\xA\\physics_previous_complete(request(_, Previous, _, _), Generation) :- Generation > Previous.\\xA\\\\xA\\%% An explicit policy action, never inferred from elapsed time. Removing this\\xA\\%% exact custody invalidates the old activation's ordinary OCC read dependency.\\xA\\%% The original bytes remain available; cancelled does not assert an operation\\xA\\%% outcome for a request that may still be in flight.\\xA\\can_cancel_physics_activation(_, _) :- fail.\\xA\\physics_cancel_activation(W, Generation, Request) :-\\xA\\    term_variables([W, Generation, Request], []),\\xA\\    transaction((current_principal(Principal), can_cancel_physics_activation(W, Principal),\\xA\\        physics_run(W, Generation, _),\\xA\\        Request = request(_, Generation, _, _), physics_custody(W, Request),\\xA\\        retract(physics_request(W, Request)),\\xA\\        assertz(physics_cancelled_request(W, Request)))).\\xA\\\\xA\\%% Durable domain status is derived from the same atomic transition, not a\\xA\\%% separately maintained sent flag. Pending includes never-sent and uncertain.\\xA\\physics_activation_status(W, Request, pending) :-\\xA\\    physics_request(W, Request), Request = request(_, Generation, _, _),\\xA\\    physics_run(W, Generation, _).\\xA\\physics_activation_status(W, Request, activated) :-\\xA\\    physics_request(W, Request), Request = request(Token, Previous, _, _),\\xA\\    Generation is Previous + 1, physics_run(W, Generation, Token).\\xA\\physics_activation_status(W, Request, cancelled) :- physics_cancelled_request(W, Request).\\xA\\\\xA\\%% A reusable door recipe is deliberately pinned and materialized. Live\\xA\\%% instances instead use the source-owned definition/assignment contract below.\\xA\\physics_door_definition(local(Name, Version), Definition) :-\\xA\\    physics_door_class(Name, Version, Definition).\\xA\\physics_door_definition(class_ref(Ns, Anchor, Name, Version), Definition) :-\\xA\\    Ns::(current_ontology_identity(Ns, Anchor), physics_door_class(Name, Version, Definition)).\\xA\\\\xA\\can_edit_physics(_, _) :- fail.\\xA\\can_close_physics_door(_, _, _) :- fail.\\xA\\can_cancel_physics_door(_, _, _) :- fail.\\xA\\\\xA\\physics_add_door(W, Door, Frame, Source, Position, Structure) :-\\xA\\    term_variables([W, Door, Frame, Source, Position, Structure], []),\\xA\\    transaction((current_principal(P), can_edit_physics(W, P),\\xA\\        physics_structure(W, Structure), Door \\\\= Frame,\\xA\\        physics_reserve_body_ids(W, [Door,Frame]),\\xA\\        \\\\+ physics_body_definition(W, Door, _, _, _, _),\\xA\\        \\\\+ physics_body_definition(W, Frame, _, _, _, _),\\xA\\        physics_door_definition(Source, door(FrameBox, LeafBox, Density, Angle, Motor)),\\xA\\        physics_valid_hinge_definition(Position, FrameBox, LeafBox),\\xA\\        physics_required_allowances(W, limits(_, _, _, Coordinate, _), _, _, _),\\xA\\        physics_checked_body(Door, dynamic, Position, LeafBox, Density, Coordinate),\\xA\\        physics_checked_body(Frame, fixed, Position, FrameBox, Density, Coordinate),\\xA\\        physics_valid_motor(Angle, Motor),\\xA\\        physics_body_capacity(W,2),\\xA\\        Next is Structure + 1,\\xA\\        retract(physics_structure(W, Structure)), assertz(physics_structure(W, Next)),\\xA\\        assertz(physics_body_definition(W, Frame, Next, fixed, Position, owned(FrameBox, Density))),\\xA\\        assertz(physics_body_definition(W, Door, Next, dynamic, Position, owned(LeafBox, Density))),\\xA\\        assertz(physics_joint(W, hinge(Door, Next, Frame, vector(0,0,0), Angle, Motor))),\\xA\\        assertz(physics_door_source(W, Door, Source)),\\xA\\        assertz(physics_door(W, Door, 0, idle)))).\\xA\\\\xA\\%% Shared authored-body schema. Native installation still checks numeric\\xA\\%% representation, hull volume, triangle area and supported joint mechanics.\\xA\\%% A surface is explicit fixed collision coverage, never a moving solid.\\xA\\physics_valid_body(Id, Kind, Pose, Shape, Density, Coordinate) :-\\xA\\    term_variables([Id, Kind, Pose, Shape, Density, Coordinate], []),\\xA\\    integer(Id), Id >= 0, Id < 18446744073709551616,\\xA\\    member(Kind, [fixed, dynamic, controlled]), physics_positive_scalar(Density),\\xA\\    integer(Coordinate), Coordinate > 0,\\xA\\    physics_valid_pose(Pose, Coordinate), physics_valid_shape(Kind, Shape, Coordinate).\\xA\\physics_checked_body(Id, Kind, Pose, Shape, Density, Coordinate) :-\\xA\\    (physics_valid_body(Id, Kind, Pose, Shape, Density, Coordinate) -> true\\xA\\    ; fail_with_reason(invalid_physics_body(Id))).\\xA\\physics_valid_pose(vector(X,Y,Z), Coordinate) :-\\xA\\    physics_body_vector(vector(X,Y,Z), Coordinate).\\xA\\physics_valid_pose(pose(Position, rotation(X,Y,Z)), Coordinate) :-\\xA\\    physics_body_vector(Position, Coordinate),\\xA\\    physics_milli_integer(X), physics_milli_integer(Y), physics_milli_integer(Z).\\xA\\physics_valid_shape(_, Shape, Coordinate) :- physics_valid_solid(Shape, Coordinate).\\xA\\physics_valid_shape(_, parts(Parts), Coordinate) :-\\xA\\    Parts = [_ | _], physics_valid_parts(Parts, Coordinate).\\xA\\physics_valid_shape(fixed, surface(Vertices, Triangles), Coordinate) :-\\xA\\    Vertices = [_,_,_ | _], physics_valid_vertices(Vertices, Coordinate),\\xA\\    length(Vertices, Count), Triangles = [_ | _], physics_valid_triangles(Triangles, Count).\\xA\\physics_valid_solid(box(X,Y,Z), Coordinate) :-\\xA\\    physics_dimension(X, Coordinate), physics_dimension(Y, Coordinate), physics_dimension(Z, Coordinate).\\xA\\physics_valid_solid(ball(Radius), Coordinate) :- physics_dimension(Radius, Coordinate).\\xA\\physics_valid_solid(capsule(HalfSegment, Radius), Coordinate) :-\\xA\\    physics_dimension(HalfSegment, Coordinate), physics_dimension(Radius, Coordinate).\\xA\\physics_valid_solid(convex(Vertices), Coordinate) :-\\xA\\    Vertices = [_,_,_,_ | _], physics_valid_vertices(Vertices, Coordinate).\\xA\\physics_dimension(X, Coordinate) :- physics_body_coordinate(X, Coordinate), X > 0.\\xA\\physics_valid_parts([], _).\\xA\\physics_valid_parts([part(Pose, Solid) | Rest], Coordinate) :-\\xA\\    physics_valid_pose(Pose, Coordinate), physics_valid_solid(Solid, Coordinate),\\xA\\    physics_valid_parts(Rest, Coordinate).\\xA\\physics_valid_vertices([], _).\\xA\\physics_valid_vertices([Vertex | Rest], Coordinate) :-\\xA\\    physics_body_vector(Vertex, Coordinate), physics_valid_vertices(Rest, Coordinate).\\xA\\physics_valid_triangles([], _).\\xA\\physics_valid_triangles([triangle(A,B,C) | Rest], Count) :-\\xA\\    physics_vertex_index(A, Count), physics_vertex_index(B, Count), physics_vertex_index(C, Count),\\xA\\    A \\\\= B, B \\\\= C, A \\\\= C, physics_valid_triangles(Rest, Count).\\xA\\physics_vertex_index(Index, Count) :-\\xA\\    integer(Index), Index >= 0, Index < 4294967296, Index < Count.\\xA\\%% IEEE-754 binary32's largest finite value; this is an encoding envelope,\\xA\\%% not a resource allowance. Policy still supplies each coordinate limit.\\xA\\physics_native_scalar_limit(340282346638528859811704183484516925440).\\xA\\physics_positive_scalar(X) :-\\xA\\    integer(X), X > 0, physics_native_scalar_limit(Max), X =< Max.\\xA\\physics_milli_integer(X) :-\\xA\\    integer(X), physics_native_scalar_limit(Max), Limit is Max * 1000,\\xA\\    X >= -Limit, X =< Limit.\\xA\\physics_coordinate(X, Limit) :-\\xA\\    physics_milli_integer(X), X >= -Limit, X =< Limit.\\xA\\physics_body_vector(vector(X,Y,Z), Limit) :-\\xA\\    physics_body_coordinate(X, Limit), physics_body_coordinate(Y, Limit), physics_body_coordinate(Z, Limit).\\xA\\physics_body_coordinate(X, Limit) :-\\xA\\    physics_milli_integer(X),\\xA\\    (physics_coordinate(X, Limit) -> true ; fail_with_reason(coordinate_allowance(Limit))).\\xA\\physics_valid_hinge_definition(Position, Frame, Leaf) :-\\xA\\    (Position = vector(_,_,_), Frame = box(_,_,_), Leaf = box(_,_,_) -> true\\xA\\    ; fail_with_reason(unsupported_hinge_definition)).\\xA\\physics_valid_motor(Angle, motor(Stiffness, Damping, Torque, Tolerance)) :-\\xA\\    integer(Angle), Angle > 0, Angle < 3142,\\xA\\    physics_positive_scalar(Stiffness), physics_positive_scalar(Damping),\\xA\\    physics_positive_scalar(Torque), integer(Tolerance), Tolerance > 0, Tolerance < Angle.\\xA\\\\xA\\%% The sequence belongs to the activity, not to body or authored revisions.\\xA\\%% A caller cannot reuse an old request by recycling its human-chosen id.\\xA\\physics_close_door(W, D, Sequence, Id) :-\\xA\\    term_variables([W,D,Sequence,Id], []), agent_identifier(Id),\\xA\\    transaction((current_principal(P), can_close_physics_door(W,D,P),\\xA\\        physics_door(W,D,Sequence,Before), Before \\\\= closing(_),\\xA\\        physics_enabled(W,_), physics_joint(W,hinge(D,_,_,_,_,_)),\\xA\\        retract(physics_door(W,D,Sequence,Before)), Next is Sequence + 1,\\xA\\        assertz(physics_door(W,D,Next,closing(close(Next,Id)))),\\xA\\        physics_remove_door_request(W,D))).\\xA\\\\xA\\physics_cancel_door(W,D,Request) :-\\xA\\    term_variables([W,D,Request], []),\\xA\\    transaction((current_principal(P), can_cancel_physics_door(W,D,P),\\xA\\        retract(physics_door(W,D,Sequence,closing(Request))),\\xA\\        assertz(physics_door(W,D,Sequence,cancelled(Request))))).\\xA\\\\xA\\physics_door_custody(W,D,Custody) :-\\xA\\    findall(R, physics_door_request(W,D,R), Rows),\\xA\\    (Rows = [] -> Custody = none ; Rows = [Custody]).\\xA\\\\xA\\%% Authenticated owner metadata exists only during read-only reaction matching.\\xA\\%% The selected signed action contains the entire frozen sample.\\xA\\react_on(observed(Sample), physics_finish_door(Sample, Result)) :-\\xA\\    physics_observation(Sample),\\xA\\    Sample = door_sample(W,D,_,_,_,_,_,_,_,_,_,_,_,_),\\xA\\    physics_door_measurement(Sample, Result), physics_door_custody(W,D,Prior),\\xA\\    prepare_signed_request(Bytes, Signature,\\xA\\        physics_store_door_request(Sample, Result, Prior, Bytes, Signature)).\\xA\\\\xA\\physics_store_door_request(Sample, Result, Prior, Bytes, Signature) :-\\xA\\    term_variables([Sample,Result,Prior,Bytes,Signature], []),\\xA\\    transaction((physics_door_measurement(Sample,Result),\\xA\\        Sample = door_sample(W,D,_,_,_,_,_,_,_,_,_,_,_,_), physics_actor(W),\\xA\\        physics_door_custody(W,D,Prior), physics_door_replaceable(Prior,Sample),\\xA\\        signed_physics_request(physics_finish_door(Sample,Result), Bytes, Signature),\\xA\\        physics_remove_door_request(W,D),\\xA\\        assertz(physics_door_request(W,D,request(Sample,Result,Bytes,Signature))))).\\xA\\\\xA\\physics_door_replaceable(none,_).\\xA\\physics_door_replaceable(request(Previous,_,Bytes,Signature),Sample) :-\\xA\\    Previous = door_sample(_,_,_,_,_,OldGeneration,_,_,_,_,OldTick,_,_,_),\\xA\\    Sample = door_sample(_,_,_,_,_,Generation,_,_,_,_,Tick,_,_,_),\\xA\\    (Generation > OldGeneration ; Generation = OldGeneration, Tick > OldTick),\\xA\\    physics_request_rejected(Bytes,Signature).\\xA\\\\xA\\physics_finish_door(Sample,Result) :-\\xA\\    term_variables([Sample,Result], []),\\xA\\    transaction((physics_door_measurement(Sample,Result),\\xA\\        Sample = door_sample(W,D,R,_,_,Generation,_,_,Revision,_,Tick,Angle,_,_),\\xA\\        physics_actor(W), physics_door_request(W,D,request(Sample,Result,Bytes,Signature)),\\xA\\        current_signed_request(Bytes,Signature),\\xA\\        retract(physics_door(W,D,Sequence,closing(R))),\\xA\\        assertz(physics_door(W,D,Sequence,finished(R,Result))),\\xA\\        physics_remove_door_checkpoint(W,D),\\xA\\        assertz(physics_checkpoint(W,hinge(D,Revision,Generation,Tick,Angle))),\\xA\\        trigger_event(physics_door_finished(W,D,R,Result)))).\\xA\\\\xA\\physics_door_measurement(\\xA\\    door_sample(W,D,R,Authority,Epoch,Generation,Token,Structure,Revision,FrameRevision,\\xA\\                Tick,Angle,Contact,validity(At,Expiry)), Result) :-\\xA\\    physics_enabled(W,I), current_ontology_identity(Ns,Anchor),\\xA\\    Authority = agent_instance_ref(Ns,Anchor,I), agent_hosted(I,_,Epoch,_),\\xA\\    physics_run(W,Generation,Token), physics_structure(W,Structure),\\xA\\    physics_door(W,D,_,closing(R)), physics_body_definition(W,D,Revision,dynamic,_,_),\\xA\\    physics_joint(W,hinge(D,Revision,Frame,_,Baseline,motor(_,_,_,Tolerance))),\\xA\\    physics_body_definition(W,Frame,FrameRevision,fixed,_,_),\\xA\\    integer(Tick), Tick > 0, Tick < 18446744073709551616, integer(Angle), Angle >= -Baseline, Angle =< Baseline,\\xA\\    physics_required_allowances(W,_,_,_,Budget),\\xA\\    integer(At), integer(Expiry), Expiry > At, Expiry - At =< Budget,\\xA\\    current_request_expiry(RequestExpiry), RequestExpiry > At, RequestExpiry =< Expiry,\\xA\\    physics_door_result(W,D,Frame,Angle,Tolerance,Contact,Result).\\xA\\physics_door_result(W,D,Frame,_,_,contact(Other,Revision),blocked(Other)) :-\\xA\\    Other \\\\= D, Other \\\\= Frame, physics_body_definition(W,Other,Revision,_,_,_).\\xA\\physics_door_result(_,_,_,Angle,Tolerance,clear,closed) :-\\xA\\    Angle >= -Tolerance, Angle =< Tolerance.\\xA\\\\xA\\physics_remove_door_request(W,D) :-\\xA\\    physics_door_custody(W,D,C), (C = none -> true ; retract(physics_door_request(W,D,C))).\\xA\\physics_remove_door_checkpoint(W,D) :-\\xA\\    findall(C, (physics_checkpoint(W,C), C = hinge(D,_,_,_,_)), Rows),\\xA\\    (Rows = [] -> true ; Rows = [Old], retract(physics_checkpoint(W,Old))).\\xA\\\\xA\\\\xA\\%% A free obstacle edit advances the conservative whole-world fence. Door\\xA\\%% activity remains pending; a pre-edit observation cannot finish it.\\xA\\physics_move_body(W,D,Revision,Structure,Position) :-\\xA\\    term_variables([W,D,Revision,Structure,Position], []),\\xA\\    transaction((current_principal(P), can_edit_physics(W,P),\\xA\\        physics_structure(W,Structure), physics_body_definition(W,D,Revision,Kind,Old,Definition),\\xA\\        physics_resolve_definition(W,Definition,Shape,Density),\\xA\\        \\\\+ physics_joint(W,hinge(D,_,_,_,_,_)),\\xA\\        \\\\+ physics_joint(W,hinge(_,_,D,_,_,_)),\\xA\\        physics_required_allowances(W,limits(_,_,_,Coordinate, _),_,_,_),\\xA\\        Position = vector(_,_,_), physics_relocated_pose(Old,Position,Pose),\\xA\\        physics_checked_body(D,Kind,Pose,Shape,Density,Coordinate),\\xA\\        Next is Structure + 1,\\xA\\        retract(physics_structure(W,Structure)), assertz(physics_structure(W,Next)),\\xA\\        retract(physics_body_definition(W,D,Revision,Kind,Old,Definition)),\\xA\\        assertz(physics_body_definition(W,D,Next,Kind,Pose,Definition)),\\xA\\        physics_remove_rest_checkpoint(W,D),\\xA\\        physics_cancel_rest_edit(W,D))).\\xA\\\\xA\\physics_relocated_pose(vector(_,_,_),Position,Position).\\xA\\physics_relocated_pose(pose(_,Rotation),Position,pose(Position,Rotation)).\\xA\\\\xA\\%% A structural edit resets the whole supported joint group. It also cancels\\xA\\%% its active objective; restoration cannot reinstate a pre-edit closed state.\\xA\\physics_move_door(W,D,Sequence,Structure,Position) :-\\xA\\    term_variables([W,D,Sequence,Structure,Position], []),\\xA\\    transaction((current_principal(P), can_edit_physics(W,P), physics_structure(W,Structure),\\xA\\        physics_door(W,D,Sequence,State),\\xA\\        physics_joint(W,hinge(D,Revision,F,Pivot,Angle,Motor)),\\xA\\        physics_body_definition(W,D,Revision,dynamic,LeafPosition,owned(LeafBox,Density)),\\xA\\        physics_body_definition(W,F,Revision,fixed,FramePosition,owned(FrameBox,Density)),\\xA\\        physics_required_allowances(W,limits(_,_,_,Coordinate, _),_,_,_),\\xA\\        physics_valid_hinge_definition(Position,FrameBox,LeafBox),\\xA\\        physics_checked_body(D,dynamic,Position,LeafBox,Density,Coordinate),\\xA\\        physics_checked_body(F,fixed,Position,FrameBox,Density,Coordinate), Next is Structure + 1,\\xA\\        retract(physics_structure(W,Structure)), assertz(physics_structure(W,Next)),\\xA\\        retract(physics_body_definition(W,D,Revision,dynamic,LeafPosition,owned(LeafBox,Density))),\\xA\\        retract(physics_body_definition(W,F,Revision,fixed,FramePosition,owned(FrameBox,Density))),\\xA\\        assertz(physics_body_definition(W,D,Next,dynamic,Position,owned(LeafBox,Density))),\\xA\\        assertz(physics_body_definition(W,F,Next,fixed,Position,owned(FrameBox,Density))),\\xA\\        retract(physics_joint(W,hinge(D,Revision,F,Pivot,Angle,Motor))),\\xA\\        assertz(physics_joint(W,hinge(D,Next,F,Pivot,Angle,Motor))),\\xA\\        physics_remove_door_checkpoint(W,D),\\xA\\        retract(physics_door(W,D,Sequence,State)),\\xA\\        (State = closing(R) -> After = cancelled(R) ; After = idle),\\xA\\        assertz(physics_door(W,D,Sequence,After)))).\\xA\\\\xA\\% Replacement custody requires exact terminal evidence captured in the proof's\\xA\\% ordinary read set. Unknown or unpublished outcomes cannot prove rejection.\\xA\\physics_request_rejected(Bytes, Signature) :-\\xA\\    committed_operation_outcome(Bytes, Signature, Status),\\xA\\    (Status = rejected ; Status = aborted).\\xA\\\\xA\\\\xA\\%% Rest checkpoint requests are explicit policy actions, independent of hot\\xA\\%% impulses. Their fulfilment uses the same owned observation/custody lane as\\xA\\%% door consequences. The author baseline is never overwritten by a sample.\\xA\\physics_rest(_, _, _, _) :- fail.\\xA\\can_checkpoint_physics_body(_, _, _) :- fail.\\xA\\physics_rest_policy(_, _, _) :- fail.\\xA\\\\xA\\physics_checkpoint_body(W,D,Revision,Sequence,Id) :-\\xA\\    term_variables([W,D,Revision,Sequence,Id], []), agent_identifier(Id),\\xA\\    transaction((current_principal(P), can_checkpoint_physics_body(W,D,P), physics_enabled(W,_),\\xA\\        (physics_free_body(W,D,Revision) -> true ; fail_with_reason(body_not_free(D))),\\xA\\        (physics_rest_policy(W,D,_) -> true ; fail_with_reason(rest_policy_missing(D))),\\xA\\        physics_rest_state(W,D,Current,Before),\\xA\\        (Sequence = Current -> true ; fail_with_reason(checkpoint_conflict(D))),\\xA\\        (Before \\\\= waiting(_) -> true ; fail_with_reason(checkpoint_pending(D))),\\xA\\        physics_rest_custody(W,D,Prior),\\xA\\        (physics_rest_replaceable(Prior,W,D) -> true\\xA\\        ; fail_with_reason(checkpoint_custody_held(D))),\\xA\\        physics_remove_rest_state(W,D), Next is Sequence + 1,\\xA\\        assertz(physics_rest(W,D,Next,waiting(rest(Next,Id)))),\\xA\\        physics_remove_rest_request(W,D))).\\xA\\\\xA\\physics_rest_state(W,D,Sequence,State) :-\\xA\\    findall(rest(S,T), physics_rest(W,D,S,T), Rows),\\xA\\    (Rows = [] -> Sequence = 0, State = idle\\xA\\    ; Rows = [rest(S,T)] -> Sequence = S, State = T\\xA\\    ; fail_with_reason(ambiguous_checkpoint(D))).\\xA\\physics_rest_custody(W,D,C) :-\\xA\\    findall(R, physics_rest_request(W,D,R), Rows),\\xA\\    (Rows = [] -> C = none ; Rows = [R] -> C = R\\xA\\    ; fail_with_reason(ambiguous_checkpoint_custody(D))).\\xA\\%% An authored cancellation retires this activity, not its backend operation.\\xA\\%% The changed revision makes its exact old finish permanently ineligible.\\xA\\physics_rest_replaceable(none,_,_).\\xA\\physics_rest_replaceable(request(Sample,_,Bytes,Signature),W,D) :-\\xA\\    ((physics_rest(W,D,_,finished(Sample)) ;\\xA\\      Sample = rest_sample(W,D,R,_,_,_,_,_,OldRevision,_,_,_),\\xA\\      physics_rest(W,D,_,cancelled(R)), physics_free_body(W,D,Revision),\\xA\\      Revision \\\\= OldRevision) -> true ; physics_request_rejected(Bytes,Signature)).\\xA\\\\xA\\react_on(observed(Sample), physics_finish_rest(Sample)) :-\\xA\\    physics_observation(Sample), physics_rest_measurement(Sample),\\xA\\    Sample = rest_sample(W,D,_,_,_,_,_,_,_,_,_,_), physics_rest_custody(W,D,Prior),\\xA\\    prepare_signed_request(Bytes,Signature,physics_store_rest_request(Sample,Prior,Bytes,Signature)).\\xA\\\\xA\\physics_store_rest_request(Sample,Prior,Bytes,Signature) :-\\xA\\    term_variables([Sample,Prior,Bytes,Signature], []),\\xA\\    transaction((physics_rest_measurement(Sample),\\xA\\        Sample = rest_sample(W,D,_,_,_,_,_,_,_,_,_,_), physics_actor(W),\\xA\\        physics_rest_custody(W,D,Prior),\\xA\\        (Prior = none -> true ; Prior = request(_,_,B,S), physics_request_rejected(B,S)),\\xA\\        signed_physics_request(physics_finish_rest(Sample),Bytes,Signature),\\xA\\        physics_remove_rest_request(W,D),\\xA\\        assertz(physics_rest_request(W,D,request(Sample,rest,Bytes,Signature))))).\\xA\\\\xA\\physics_finish_rest(Sample) :-\\xA\\    term_variables(Sample, []),\\xA\\    transaction((physics_rest_measurement(Sample),\\xA\\        Sample = rest_sample(W,D,R,Authority,Epoch,G,Token,Structure,Revision,Tick,Pose,_),\\xA\\        physics_actor(W), physics_rest_request(W,D,request(Sample,rest,Bytes,Signature)),\\xA\\        current_signed_request(Bytes,Signature),\\xA\\        retract(physics_rest(W,D,Sequence,waiting(R))),\\xA\\        assertz(physics_rest(W,D,Sequence,finished(Sample))),\\xA\\        physics_remove_rest_checkpoint(W,D),\\xA\\        assertz(physics_checkpoint(W,rest_v1(D,Revision,\\xA\\            source(Authority,Epoch,G,Token,Structure,Tick),world_mm_quaternion_million,Pose,zero_velocity))),\\xA\\        trigger_event(physics_body_checkpointed(W,D,R)))).\\xA\\\\xA\\physics_rest_measurement(rest_sample(W,D,R,Authority,Epoch,G,Token,Structure,Revision,Tick,Pose,\\xA\\                                     validity(At,Expiry))) :-\\xA\\    physics_enabled(W,I), current_ontology_identity(Ns,Anchor),\\xA\\    Authority = agent_instance_ref(Ns,Anchor,I), agent_hosted(I,_,Epoch,_),\\xA\\    physics_run(W,G,Token), physics_structure(W,Structure),\\xA\\    physics_free_body(W,D,Revision), physics_rest(W,D,_,waiting(R)),\\xA\\    physics_rest_policy(W,D,recovery(Tolerance,Checks)),\\xA\\    integer(Tolerance), Tolerance >= 0, integer(Checks), Checks > 0,\\xA\\    physics_required_allowances(W,limits(_,_,_,Coordinate,_),_,_,Budget),\\xA\\    Pose = pose(Position,quaternion(X,Y,Z,Q)), physics_query_vector(Position,Coordinate),\\xA\\    physics_coordinate(X,1000000), physics_coordinate(Y,1000000),\\xA\\    physics_coordinate(Z,1000000), physics_coordinate(Q,1000000),\\xA\\    Norm is X*X+Y*Y+Z*Z+Q*Q, Norm >= 999996000000, Norm =< 1000004000000,\\xA\\    integer(Tick), Tick > 0, Tick < 18446744073709551616,\\xA\\    integer(At), integer(Expiry), Expiry > At, Expiry-At =< Budget,\\xA\\    current_request_expiry(RequestExpiry), RequestExpiry > At, RequestExpiry =< Expiry,\\xA\\    \\\\+ (physics_checkpoint(W,rest_v1(D,_,source(_,_,OldG,_,_,OldTick),_,_,_)),\\xA\\        (OldG > G ; OldG = G, OldTick >= Tick)).\\xA\\\\xA\\physics_remove_rest_state(W,D) :-\\xA\\    findall(rest(S,T),physics_rest(W,D,S,T),Rows),\\xA\\    (Rows = [] -> true ; Rows = [rest(S,T)], retract(physics_rest(W,D,S,T))).\\xA\\physics_cancel_rest_edit(W,D) :-\\xA\\    physics_rest_state(W,D,Sequence,State),\\xA\\    (State = waiting(R) -> physics_remove_rest_state(W,D),\\xA\\        assertz(physics_rest(W,D,Sequence,cancelled(R))) ; true).\\xA\\physics_remove_rest_request(W,D) :-\\xA\\    physics_rest_custody(W,D,C), (C = none -> true ; retract(physics_rest_request(W,D,C))).\\xA\\physics_remove_rest_checkpoint(W,D) :-\\xA\\    findall(C,(physics_checkpoint(W,C),C = rest_v1(D,_,_,_,_,_)),Rows),\\xA\\    (Rows = [] -> true ; Rows = [C], retract(physics_checkpoint(W,C))).\\xA\\\\xA\\physics_recovery_checkpoint(W,C) :- physics_checkpoint(W,C), C \\\\= rest_v1(_,_,_,_,_,_).\\xA\\physics_recovery_checkpoint(W,rest(C,Policy)) :-\\xA\\    physics_checkpoint(W,C), C = rest_v1(D,_,_,_,_,_),\\xA\\    findall(P,physics_rest_policy(W,D,P),Policies),\\xA\\    (Policies = [Policy] -> true ; Policy = invalid).\\xA\\\\xA\\physics_authorship_2BECA9CD77218D5D(ready).\\xA\\\">>) , findall(assertz(V1), member(V1, V0), V2) , run_transition(V2)))).">>},
