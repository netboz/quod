{
  "script": "const done=arguments[arguments.length-1]; import(performance.getEntriesByType('resource').find(r=>r.name.includes('engineStore')).name).then(({EngineStore})=>{const scene=EngineStore.LastCreatedScene,m=scene.getMeshByName('workspace'),height=m.position.y; if(window.guiTestFollow)scene.onBeforeRenderObservable.remove(window.guiTestFollow);m.scaling.setAll(1.25);window.guiTestFollow=scene.onBeforeRenderObservable.add(()=>{const c=scene.activeCamera;c.getViewMatrix(true);const p=c.globalPosition,d=c.getForwardRay().direction.clone();d.y=0;if(d.lengthSquared()<.0001)return;d.normalize();m.position.copyFrom(p.add(d.scale(1.5625)));m.position.y=height;m.rotationQuaternion=null;m.rotation.set(-Math.PI/3,Math.atan2(-d.x,-d.z),0);});done({height,slopeDegrees:30,distance:1.5625,scale:1.25,verticalFollow:false});}).catch(e=>done({error:String(e)}));",
  "result": {
    "value": {
      "distance": 1.5625,
      "height": 0.08817580938339231,
      "scale": 1.25,
      "slopeDegrees": 30,
      "verticalFollow": false
    }
  }
}
