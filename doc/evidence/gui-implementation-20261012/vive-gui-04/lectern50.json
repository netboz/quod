{
  "script": "const done=arguments[arguments.length-1]; import(performance.getEntriesByType('resource').find(r=>r.name.includes('engineStore')).name).then(({EngineStore})=>{const scene=EngineStore.LastCreatedScene,m=scene.getMeshByName('workspace'),height=m.position.y+0.2;if(window.guiTestFollow)scene.onBeforeRenderObservable.remove(window.guiTestFollow);m.scaling.setAll(1.5);window.guiTestFollow=scene.onBeforeRenderObservable.add(()=>{const c=scene.activeCamera;c.getViewMatrix(true);const p=c.globalPosition,d=c.getForwardRay().direction.clone();d.y=0;if(d.lengthSquared()<.0001)return;d.normalize();m.position.copyFrom(p.add(d.scale(1.9)));m.position.y=height;m.rotationQuaternion=null;m.rotation.set(-40*Math.PI/180,Math.atan2(-d.x,-d.z),0);});done({height,slopeDegrees:50,distance:1.9,scale:1.5,verticalFollow:false});}).catch(e=>done({error:String(e)}));",
  "result": {
    "value": {
      "distance": 1.9,
      "height": 0.2881758093833923,
      "scale": 1.5,
      "slopeDegrees": 50,
      "verticalFollow": false
    }
  }
}
