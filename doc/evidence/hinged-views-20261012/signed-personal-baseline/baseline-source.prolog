'$quod_stricter_class'(V0, V1) :- member(V2, V1) , isa(V2, V0) , \+ isa(V0, V2).
'$quod_transitive_isa'(V0, V1) :- '$quod_isa_requires_closure'(V0, V1) , '$quod_direct_isa'(V0, V2) , \+ member_eq(V2, [V0]) , '$quod_isa_path'(V2, V1, [V2, V0]).
