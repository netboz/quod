+    agent_request_bytes(Typed, Bytes),
+    Typed = agent_goal_v1(Network, _, _, _, _, TargetExpiry, execute, 3, _),
+    TargetExpiry =< Expiry,
+    can_instruct_personal_agent(Owner, Typed).
