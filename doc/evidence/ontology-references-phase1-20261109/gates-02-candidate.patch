+agent_converge_candidate([], _, _, _).
+agent_converge_candidate([candidate(_, NodeRef, PublicKey)|_], Instance, OldNode, OldEpoch) :-
+    Epoch is OldEpoch + 1,
+    goal(agent_assignment(Instance, OldNode, OldEpoch, NodeRef, Epoch, PublicKey)).
