+signed_owner_transition(Owner, Goal) ->
+    {Numbered, _, _} = erlog_int:term_instance({'::', Owner, Goal}, 0),
+    {ok, Bytes, Signature} = quod_node_actor:signed_goal(execute, Numbered,
