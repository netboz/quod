+class_owner_hosting_transitions_test_() ->
+    {timeout, 60, fun() -> with_host(fun(#{namespace := Ns, reference := Agent,
+            node := Node, key := Key, directory := Dir, identity := Identity}) ->
+        Owner = <<"quod:agent">>,
