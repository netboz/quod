+                signed_owner_transition(Owner, Move)),
+            ?assertMatch({ok, [_], _},
+                quod_prolog:prove_ro(Ns, {agent_key, actor, Key, revoked})),
+            ?assertMatch({ok, [_], _},
+                quod_prolog:prove_ro(Ns, {agent_hosted, actor, Node, 2, NewKey})),
