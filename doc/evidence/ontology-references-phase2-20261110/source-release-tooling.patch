+%% Binary facts enter through the same signed root authority and target edit
+%% gate as source changes, without passing their payload through the editor.
+%% Dry runs return the exact goal for review; execution submits it only once.
+terms(Ns, Terms, DryRun) when is_list(Terms), Terms =/= [] ->
+    Conj = fun C([G]) -> G; C([G | Rest]) -> {',', G, C(Rest)} end,
+    Goal = {'::', Ns, {',', {current_ontology_identity, Ns, quod_simplex:genesis_hash(Ns)},
+        {',', system_prolog_edit, {transaction, Conj([{assertz, Term} || Term <- Terms])}}}},
+    case DryRun of
+        true -> {planned, Goal};
+        false -> quod_prolog:execute(?ROOT, Goal)
+    end.
