+        agent_instance_text => <<"human.">>, signing_public_key => maps:get(pubkey, Identity),
+        operation_id => crypto:strong_rand_bytes(32), not_after_ms => quod_time:now_ms() + 10000,
+        mode => Mode, parser_version => 3, goal_text => Text}),
+    {ok, _, Outcome} = quod_client_goal_ingress:submit(Bytes, quod_identity:sign(Bytes, Identity)),
+    Outcome.
+
+commit(Ns, Goal) -> ?assertMatch({ok, _, _}, quod_ct:rp(Ns, Goal)).
+
