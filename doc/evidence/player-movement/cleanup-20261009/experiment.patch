+-module(quod_external_predicate_selection_tests).
+-include_lib("eunit/include/eunit.hrl").
+
+signed_selection_authorization_rollback_and_repeat_cost_test_() ->
+    {timeout, 60, fun() -> with_owner(fun(F = #{namespace := Ns, human := Human}) ->
+        Initial = selection(Ns),
+        WithoutPhysics = lists:delete(quod_physics_predicates, Initial),
+        ?assertMatch({normalized, {failed, _}}, signed(F, execute,
+            {configure_external_predicates, [], WithoutPhysics})),
+        ?assertMatch({normalized, {committed, _, _}}, signed(F, execute,
+            {';', {transaction, {',', configure(Initial, WithoutPhysics), fail}}, true})),
+        ?assertEqual(Initial, selection(Ns)),
+        ?assertMatch({normalized, {committed, _, _}},
+                     signed(F, execute, configure(Initial, WithoutPhysics))),
+        ?assertEqual(WithoutPhysics, selection(Ns)),
+        ?assertMatch({normalized, {answers, _, [_]}}, signed(F, read,
+            {'\\+', physics_bridge_probe()})),
+        Owner = quod_reg:where({quod_prolog, Ns}),
+        Height = quod_prolog:applied(Ns),
+        MFAs = [{quod_predicates, module_manifest, 1},
+                {quod_committed_projection, apply_entry, 3},
+                {file, read_file, 1}, {file, write_file, 2}, {file, sync, 1}],
+        lists:foreach(fun(MFA) -> erlang:trace_pattern(MFA, true, [local]) end, MFAs),
+        1 = erlang:trace(Owner, true, [call]),
+        try
+            ?assertMatch({normalized, {answers, _, [_]}},
+                         signed(F, read, {external_predicate_configuration, WithoutPhysics})),
+            ?assertEqual(Height, quod_prolog:applied(Ns)),
+            Barrier = erlang:trace_delivered(Owner),
+            ?assertEqual([], owner_calls(Owner, Barrier, []))
+        after
+            erlang:trace(Owner, false, [call]),
+            lists:foreach(fun(MFA) -> erlang:trace_pattern(MFA, false, [local]) end, MFAs)
+        end,
+        ?assertMatch({normalized, {committed, _, _}},
+                     signed(F, execute, configure(WithoutPhysics, Initial))),
+        ?assertMatch({normalized, {answers, _, [_]}}, signed(F, read,
+            physics_bridge_probe())),
+        commit(Ns, {retract, {can_configure_external_predicates, Human, {'_'}}}),
+        ?assertMatch({normalized, {failed, _}},
+                     signed(F, execute, configure(Initial, WithoutPhysics))),
+        ?assertEqual(Initial, selection(Ns))
+    end) end}.
+
+signed_selection_recovery_and_invalid_candidate_test_() ->
+    {timeout, 60, fun() -> with_owner(fun(F = #{namespace := Ns}) ->
+        Initial = selection(Ns),
+        WithoutPhysics = lists:delete(quod_physics_predicates, Initial),
+        ?assertMatch({normalized, {committed, _, _}},
+                     signed(F, execute, configure(Initial, WithoutPhysics))),
+        %% The invalid candidate must not publish its facts or alter the live registry.
+        ?assertMatch({normalized, {rejected, invalid_external_predicate_selection, _}},
+            signed(F, execute, configure(WithoutPhysics, [quod_ask]))),
+        ?assertEqual(WithoutPhysics, selection(Ns)),
+        true = quod_reg:subscribe({runtime, Ns}),
+        try
+            Supervisor = quod_reg:where({quod_ns, Ns}),
+            ok = supervisor:terminate_child(Supervisor, quod_prolog),
+            ?assertMatch({ok, _}, supervisor:restart_child(Supervisor, quod_prolog)),
+            receive {replay_ready, _, _} -> ok
+            after 10000 -> error(selection_replay_not_ready) end,
+            ?assertEqual(WithoutPhysics, selection(Ns)),
+            ?assertMatch({normalized, {answers, _, [_]}}, signed(F, read,
+                {'\\+', physics_bridge_probe()})),
+            ?assertMatch({normalized, {committed, _, _}},
+                signed(F, execute, configure(WithoutPhysics, Initial))),
+            ?assertMatch({normalized, {answers, _, [_]}}, signed(F, read,
+                physics_bridge_probe()))
