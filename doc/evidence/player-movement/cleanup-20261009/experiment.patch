+
+configure(Current, Next) -> {configure_external_predicates, Current, Next}.
+
+%% An installed bridge validates the body argument before any world lookup.
+%% Catch that native error; an absent bridge simply fails under unknown=fail.
+physics_bridge_probe() ->
+    {'catch', {physics_body_state, room, {'Body'}, {'Result'}}, {'Error'},
+        {'=', {'Error'}, instantiation_error}}.
+
+selection(Ns) ->
+    {ok, [#{'Modules' := Modules}], _} = quod_prolog:prove_ro(
+        Ns, {external_predicate_configuration, {'Modules'}}), Modules.
+
+owner_calls(Owner, Barrier, Calls) ->
+    receive
+        {trace, Owner, call, MFA} -> owner_calls(Owner, Barrier, [MFA | Calls]);
+        {trace_delivered, Owner, Barrier} -> lists:reverse(Calls)
+    after 5000 -> error(owner_trace_not_delivered) end.
+
+signed(#{namespace := Ns, human := {agent_instance_ref, HNs, Anchor, human},
