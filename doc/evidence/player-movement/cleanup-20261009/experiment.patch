 %%
 %% This file contains framework mechanics only. Domain rules belong in the
 %% ontology that owns them.
+
+%% Founding provenance is immutable. Its module names are the initial bridge
+%% selection; an authored replacement changes only the effective selection.
+external_predicate_configuration(Modules) :-
+    findall(M, external_predicate_selection(M), [Modules]).
+external_predicate_configuration(Modules) :-
+    \+ external_predicate_selection(_),
+    external_predicate_modules(Manifest),
+    external_predicate_names(Manifest, Modules).
+
+external_predicate_names([], []).
+external_predicate_names([Entry | Rest], [Module | Modules]) :-
+    Entry =.. [Module, _Digest],
+    external_predicate_names(Rest, Modules).
+
+can_configure_external_predicates(_, _) :- fail.
+
+configure_external_predicates(Expected, Modules) :-
+    term_variables(Expected-Modules, []),
+    external_predicate_name_list(Modules, []),
+    transaction((me(Principal), can_configure_external_predicates(Principal, Modules),
+        external_predicate_configuration(Current),
+        (Current == Expected -> true ; fail_with_reason(external_predicate_configuration_conflict)),
+        (Current == Modules -> true
+        ; (\+ external_predicate_selection(_) -> true
+          ; retract(external_predicate_selection(Current))),
+          assertz(external_predicate_selection(Modules))))).
+
+external_predicate_name_list([], _).
+external_predicate_name_list([Name | Rest], Seen) :-
+    atom(Name), \+ member_eq(Name, Seen),
+    external_predicate_name_list(Rest, [Name | Seen]).
 
