+    // pre-sandbox hook. Their closure must be resident before confinement.
+    "libGLX_nvidia.so.0",
+    "libEGL.so.1",
+    "libxcb-dri3.so.0",
+    "libxcb-glx.so.0",
+    "libxcb-present.so.0",
+    "libxcb-sync.so.1",
     "libvulkan_lvp.so",
     // Mesa implicit layers the Vulkan loader activates by default.
     "libVkLayer_MESA_device_select.so",
@@ -388,6 +396,17 @@ std::vector<BrokerFilePermission> GetOpenXrFilePermissions(
     permissions.push_back(BrokerFilePermission::ReadWrite(
         base::StringPrintf("/dev/dri/card%d", i)));
   }
+  // NVIDIA uses its own character devices in addition to DRM. Match the
+  // regular GPU sandbox's named grants; do not expose the whole /dev tree.
+  permissions.push_back(BrokerFilePermission::ReadWrite("/dev/nvidiactl"));
+  for (int i = 0; i < 10; ++i) {
+    permissions.push_back(BrokerFilePermission::ReadWrite(
+        base::StringPrintf("/dev/nvidia%d", i)));
+  }
+  permissions.push_back(BrokerFilePermission::ReadWrite("/dev/nvidia-modeset"));
+  permissions.push_back(
+      BrokerFilePermission::ReadOnly("/proc/driver/nvidia/params"));
+
   add_dir("/sys/dev/char");
   add_dir("/sys/class/drm");
   add_dir("/sys/devices");
