+    return (...args) => {
+      if (!retiring && (disposed || attempt?.stopped)) return
+      try { return callback(...args) } catch (cause) { fail(cause) }
+    }
+  }
+  function fail(cause) {
+    report(cause)
+    if (attempt) {
+      attempt.failed = true
+      void stop(attempt).catch(report)
+    }
+  }
