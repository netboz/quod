 isa(ontology, thing).
 instance_of(ontology, ontology_ref(Namespace, Anchor)) :-
     current_ontology_identity(Namespace, Anchor).
+
+%% Predicate subjects are derived from the authorized catalogue, not stored
+%% objects. Their clauses retain the source owner's semantic order.
+isa(predicate, thing).
+instance_of(predicate, predicate_ref(Namespace, Anchor, Indicator)) :-
+    current_ontology_identity(Namespace, Anchor),
+    quod:root::system_ontology(<<"quod:gui">>, ToolsAnchor),
+    in_ontology(<<"quod:gui">>, ToolsAnchor,
+        prolog_predicates(ontology_ref(Namespace, Anchor), Indicators)),
+    member(Indicator, Indicators).
 
 class_eidolon(Class, prolog, source, recipe(Namespace, Anchor, prolog_editor)) :-
     nonvar(Class),
