+    error => { status.textContent = String(error) })
+  await scene.whenReadyAsync(); scene.render()
+  const triangles = rows.reduce((n, row) => n + row.triangles, 0)
+  status.textContent = `${edited ? 'Excavated' : 'Original'} · ${triangles.toLocaleString()} triangles · 1 m samples · ${fixture.changed_chunks} chunks changed by digging`
+  return { triangles, chunks: rows.length, edited, meshes: scene.meshes.length }
+}
+window.voxelReady = (async () => {
