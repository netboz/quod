+  if (!response.ok) throw new Error(`Fixture unavailable: ${response.status}`)
+  fixture = await response.json()
+  const textures = ['25ebb5a3408f3a17e80ee1d56fc1290c945076ee648aacb8ac5ff6a0725fc46c','e3637cbd17d1f086f32ebdf21c8399b0bac9d6dccecae1bd2207482895e17678']
+  const palette = fixture.palette.map(([id, colour]) => {
+    const digest = textures[id === 1 ? 0 : 1]
+    const tint = id === 1 ? '#B7D6AA' : colour
+    return `material(${id},surface(<<"${tint}">>,0,900,0,[texture(<<"base_colour">>,asset(<<"${digest}">>,<<"image/jpeg">>),repeat(500,500))]))`
+  }).join(',')
+  const marks = readMarks(`[mark(<<"terrain">>,<<"terrain">>,terrain_geometry(<<"qvt1">>,[${palette}],view_distance(20000,8000,8000),resources(4000000,8000000,100000,50000,512)),body_pose(0,1),terrain_surfaces,unlabelled,depicts(<<"preview">>,<<"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">>,land))]`)
+  painted = paintMarks(scene, marks, painted, resources)
