+async function show(edited) {
+  const rows = fixture[edited ? 'after' : 'before']
+  const terrain = new Map(rows.map(row => [`0:${row.chunk.join(',')}`, { ...row,
+    body: '0', revision: '1', spacing_mm: fixture.spacing_mm,
+    payload: Uint8Array.from(atob(row.payload), c => c.charCodeAt(0)),
