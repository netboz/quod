+import { readMarks } from '../src/marks.js'
+import { paintMarks, paintBodyPoses, paintTerrain } from '../src/scene.js'
+
+const canvas = document.getElementById('terrain'), status = document.getElementById('status')
+const engine = new Engine(canvas, true), scene = new Scene(engine)
+scene.useRightHandedSystem = true
+scene.clearColor = new Color4(0.24, 0.32, 0.35, 1)
+const camera = new ArcRotateCamera('inspection', -Math.PI / 2.9, 1.05, 77, new Vector3(0, 3, 0), scene)
+camera.minZ = 0.05; camera.lowerRadiusLimit = 2; camera.upperRadiusLimit = 120
+camera.wheelPrecision = 8; camera.attachControl(canvas, true)
+const fill = new HemisphericLight('sky', new Vector3(0, 1, 0), scene)
+fill.intensity = 0.6; fill.groundColor.set(0.24, 0.28, 0.32)
+const sun = new DirectionalLight('sun', new Vector3(-0.6, -1, 0.4), scene)
+sun.intensity = 2.1
+const resources = createRenderResources(scene)
