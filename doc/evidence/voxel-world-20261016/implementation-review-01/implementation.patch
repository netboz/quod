+const initial = new URLSearchParams(location.search)
+engine.runRenderLoop(() => scene.render())
+window.addEventListener('resize', () => engine.resize())
+window.voxelSnapshot = () => {
+  scene.render()
+  return { image: canvas.toDataURL('image/png'), status: status.textContent }
+}
+for (const button of document.querySelectorAll('[data-view]')) button.onclick = () => {
+  const views = { overview: [-Math.PI / 2.9, 1.05, 77, [0, 3, 0]],
+    cave: [Math.PI, 1.48, 32, [-11, 3, 0]], dig: [-Math.PI / 2, 0.55, 30, [11, 5, -7]] }
+  const [alpha, beta, radius, target] = views[button.dataset.view]
