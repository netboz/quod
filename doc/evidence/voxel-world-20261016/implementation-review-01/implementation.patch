+voxel_camera_interest_refuses_its_signed_chunk_allowance_before_generation_test_() ->
+    {timeout,90,fun() -> with_voxel_view(fun(#{namespace := Ns,physics := Pid,
+                                            socket := Socket,projection := Projection}) ->
