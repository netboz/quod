+     abs(TX - CX) < Size, abs(TY - Y) < Size, abs(TZ - CZ) < Size ->
+        Next is Index + 1, space_free_place(Next, X, Y, Z, SX, SZ, Size, Poses, FX, FZ)
+    ; FX = CX, FZ = CZ).
+
