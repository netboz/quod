+remove_physics_policy(Ns,Functor) ->
+    [commit(Ns,{'$quod_retract_exact',Rule}) || Rule = {':-',Head,_} <-
+        quod_prolog:read_terms("priv/ontologies/quod_physics.pl"),element(1,Head) =:= Functor],ok.
