+%% Removing a consumer can remove the query that parked the owner. Recheck
+%% actual native coverage once at that dependency change, after cancellation.
+%% An unfinished insertion or invalidated source still owns its original wait.
+remove_viewer(S) ->
+    Cleared = clear_viewer(S),
+    case Cleared of
+        #s{phase = coverage,restoring = Restores} when map_size(Restores) =:= 0 ->
+            case navigation_current(Cleared) of
+                true -> notify(installed,step_native(Cleared#s{phase = active}));
+                false -> Cleared
+            end;
+        _ -> Cleared
+    end.
