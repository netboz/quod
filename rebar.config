%%% quod — a Prolog/Brahms P2P node over QUIC (no broker, no EMQX).
%%% Transport is QUIC via the pure-Erlang `quic` library: no NIF, no C toolchain
%%% or from-source build, and a small predictable image.

{erl_opts, [debug_info]}.

{deps,
 [%% netboz/erlang_quic: fork of benoitc/erlang_quic (based on tag 1.6.5) with an
  %% RFC 9000 §10.1 idle-timer fix + sub-second keep-alive for fast (~2.5s) dead-peer
  %% detection. SHA-pinned (like erlog) so an upstream force-push can't silently change
  %% the build; benoitc is kept as `upstream` in the fork for future syncs.
  {quic, {git, "https://github.com/netboz/erlang_quic.git",
               {ref, "dfd4402159b67ed7df73379c60d8d015556e135c"}}},
  {gproc, "0.9.1"},
  {cowboy, "2.12.0"},
  {prometheus, "4.11.0"},
  {prometheus_httpd, "2.1.15"},
  %% OpenTelemetry tracing is opt-in and exported asynchronously through OTLP.
  %% The API remains a no-op when tracing is disabled; consensus data never
  %% carries trace context.
  {opentelemetry_api, "1.5.0"},
  {opentelemetry, "1.7.0"},
  {opentelemetry_exporter, "1.10.0"},
  %% netboz/erlog: fork with assert/retract hooks, bounded failure diagnostics,
  %% and transactional choice-point checkpoints,
  %% multi-term source parsing, no generic ecall/2, and the inter-ontology operator precedences
  %% (':' belongs-to xfy 600, '::' ask xfx 650 — doc/inter-ontology.md §1).
  %% SHA-pinned (not a branch ref) so an upstream force-push can't silently change
  %% the build.
  {erlog, {git, "https://github.com/netboz/erlog.git",
                {ref, "82391e5409c3b70ec7454b94a24c7eb0080e0695"}}},
  %% emqx/hocon: HOCON config file parser + schema (file-primary, env overrides).
  %% Tag-pinned; pure Erlang, no NIF. (The hex `hocon` is an unrelated dead Elixir
  %% pkg — use the git dep.)
  {hocon, {git, "https://github.com/emqx/hocon.git", {tag, "0.45.9"}}}
 ]}.

{shell,
 [{config, "config/sys.config"},
  {apps, [quod]}]}.

%%% --- Release (relx) -> native bin/quod ------------------------------------
{relx,
 [{release, {quod, "0.7.57"}, [opentelemetry_exporter,
                              {opentelemetry, temporary},
                              quod, crypto, gproc, cowboy, quic, erlog, hocon,
                              prometheus, prometheus_httpd, sasl]},
  {mode, dev},
  {sys_config, "./config/sys.config"},
  {vm_args, "./config/vm.args"},
  {extended_start_script, true}
 ]}.

{profiles,
 [{prod,
   [{relx,
     [{mode, prod},
      {include_erts, true},
      {debug_info, strip}]}]},
  {test,
   [{erl_opts, [{d, 'TEST'}]}]}
 ]}.

{dialyzer,
 [{warnings, [unmatched_returns, error_handling, unknown]},
  {plt_extra_apps, [quic, gproc, erlog, hocon, typerefl, public_key, crypto]}
 ]}.

{xref_checks,
 [undefined_function_calls, undefined_functions, locals_not_used,
  deprecated_function_calls]}.
