%%% quod — a Prolog/Brahms P2P node over QUIC (no broker, no EMQX).
%%% Transport is QUIC via the pure-Erlang `quic` library: no NIF, no C toolchain
%%% or from-source build, and a small predictable image.

{erl_opts, [debug_info]}.

{deps,
 [{quic, "1.6.5"},
  {gproc, "0.9.1"},
  {prometheus, "4.11.0"},
  {prometheus_httpd, "2.1.15"},
  %% netboz/erlog: fork with assert/retract hooks. SHA-pinned (not a branch
  %% ref) so an upstream force-push can't silently change the build.
  {erlog, {git, "https://github.com/netboz/erlog.git",
                {ref, "e0bcbec2af5a47b8e8a0b2d98277992968a23f48"}}},
  %% emqx/hocon: HOCON config file parser + schema (file-primary, env overrides).
  %% Tag-pinned; pure Erlang, no NIF. (The hex `hocon` is an unrelated dead Elixir
  %% pkg — use the git dep.)
  {hocon, {git, "https://github.com/emqx/hocon.git", {tag, "0.45.9"}}}
 ]}.

{shell,
 [{config, "config/sys.config"},
  {apps, [quod]}]}.

%%% --- Release (relx) -> native bin/quod ------------------------------------
{relx,
 [{release, {quod, "0.1.0"}, [quod, crypto, gproc, quic, erlog, hocon,
                             prometheus, prometheus_httpd, sasl]},
  {mode, dev},
  {sys_config, "./config/sys.config"},
  {vm_args, "./config/vm.args"},
  {extended_start_script, true}
 ]}.

{profiles,
 [{prod,
   [{relx,
     [{mode, prod},
      {include_erts, true},
      {debug_info, strip}]}]},
  {test,
   [{erl_opts, [{d, 'TEST'}]}]}
 ]}.

{dialyzer,
 [{warnings, [unmatched_returns, error_handling, unknown]},
  {plt_extra_apps, [quic, gproc, erlog]}
 ]}.

{xref_checks,
 [undefined_function_calls, undefined_functions, locals_not_used,
  deprecated_function_calls]}.
