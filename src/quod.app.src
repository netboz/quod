{application, quod,
 [{description, "Quod - a Prolog/Brahms P2P node over QUIC"},
  {vsn, "0.7.10"},
  %% processes register through gproc (via tuples), not local names.
  {registered, []},
  {mod, {quod_app, []}},
  {applications,
   [kernel,
    stdlib,
    sasl,
    crypto,        %% quod_brahms_sampler: HMAC-SHA256 + strong_rand_bytes
    gproc,
    cowboy,
    quic,
    erlog,
    prometheus,
    prometheus_httpd
   ]},
  {env,
   [{listen_port, 14567},
    {transactions_port, 14569},
    {alpn, "quod"},
    {certfile, "priv/certs/cert.pem"},
    {keyfile, "priv/certs/key.pem"},
    {seed_peers, []}
   ]},
  {modules, []},
  {licenses, ["AGPL-3.0-or-later"]},
  {links, []}
 ]}.
